{
  "functions": [
    {
      "source": "functions",
      "codebase": "search-sync",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "maag-frontend",
          "region": "europe-west9"
        }
      }
    ]
  }
}
