---
import Button from "@/components/common/Button.astro";
import Input from "@/components/common/Input.astro";
import { DEFAULT_LOCALE, type Locale } from "@/lib/i18n/locales";
import { AUTH_TEXT } from "@/lib/i18n/auth";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const text = AUTH_TEXT[locale];
---

<div
  x-data="$lazy('authModal')"
  x-show="$store.auth.isAuthModalOpen"
  x-on:keydown.escape.window="$store.auth.closeAuthModal()"
  x-on:value-changed.window="handleInputChange($event.detail)"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-50 flex items-center justify-center"
  style="display: none;"
>
  <!-- Overlay -->
  <div class="fixed inset-0 bg-black/50" x-on:click="$store.auth.closeAuthModal()"></div>

  <!-- Modal Content -->
  <div
    x-show="$store.auth.isAuthModalOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 scale-95"
    x-transition:enter-end="opacity-100 scale-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 scale-100"
    x-transition:leave-end="opacity-0 scale-95"
    class="relative bg-base-100 rounded-lg shadow-xl p-8 w-full max-w-md"
  >
    <!-- Login Form -->
    <template x-if="$store.auth.formType === 'login'">
      <form x-on:submit.prevent="handleSubmit">
        <h2 class="text-2xl font-bold mb-6 text-center">{text.loginTitle}</h2>
        <div class="space-y-4">
          <Input type="email" name="email" placeholder={text.email} autocomplete="email" x-bind:value="formData.email" required />
          <Input type="password" name="password" placeholder={text.password} autocomplete="current-password" x-bind:value="formData.password" required />
        </div>
        <div class="mt-6">
          <Button type="submit" class="w-full" x-bind:disabled="isLoading">
            <span x-show="!isLoading">{text.loginSubmit}</span>
            <span x-show="isLoading">{text.loading}</span>
          </Button>
        </div>
        <div class="flex items-center gap-3 my-4 text-sm text-base-content/50">
          <span class="h-px flex-1 bg-base-content/20"></span>
          {text.orDivider}
          <span class="h-px flex-1 bg-base-content/20"></span>
        </div>
        <Button type="button" variant="outline" class="w-full flex items-center justify-center gap-2" x-on:click="signInWithGoogle()" x-bind:disabled="isLoading">
          <svg class="h-5 w-5" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/>
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
            <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/>
          </svg>
          {text.continueWithGoogle}
        </Button>
        <p class="text-sm text-center mt-4">
          {text.noAccount} <button type="button" x-on:click="$store.auth.switchTo('signup')" class="text-primary hover:underline cursor-pointer">{text.toSignup}</button>
        </p>
        <p class="text-sm text-center mt-2">
          <button type="button" x-on:click="forgotPassword()" class="text-base-content/50 hover:text-primary hover:underline cursor-pointer">{text.forgotPassword}</button>
        </p>
      </form>
    </template>

    <!-- Signup Form -->
    <template x-if="$store.auth.formType === 'signup'">
      <form x-on:submit.prevent="handleSubmit">
        <h2 class="text-2xl font-bold mb-6 text-center">{text.signupTitle}</h2>
        <div class="space-y-4">
          <Input type="text" name="firstName" placeholder={text.firstName} autocomplete="given-name" x-bind:value="formData.firstName" required />
          <Input type="text" name="lastName" placeholder={text.lastName} autocomplete="family-name" x-bind:value="formData.lastName" required />
          <Input type="email" name="email" placeholder={text.email} autocomplete="email" x-bind:value="formData.email" required />
          <Input type="password" name="password" placeholder={text.password} autocomplete="new-password" x-bind:value="formData.password" required />
          <Input type="password" name="confirmPassword" placeholder={text.confirmPassword} autocomplete="new-password" x-bind:value="formData.confirmPassword" required />
        </div>
        <div class="mt-6">
          <Button type="submit" class="w-full" x-bind:disabled="isLoading">
            <span x-show="!isLoading">{text.signupSubmit}</span>
            <span x-show="isLoading">{text.loading}</span>
          </Button>
        </div>
        <div class="flex items-center gap-3 my-4 text-sm text-base-content/50">
          <span class="h-px flex-1 bg-base-content/20"></span>
          {text.orDivider}
          <span class="h-px flex-1 bg-base-content/20"></span>
        </div>
        <Button type="button" variant="outline" class="w-full flex items-center justify-center gap-2" x-on:click="signInWithGoogle()" x-bind:disabled="isLoading">
          <svg class="h-5 w-5" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/>
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
            <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/>
          </svg>
          {text.continueWithGoogle}
        </Button>
        <p class="text-sm text-center mt-4">
          {text.haveAccount} <button type="button" x-on:click="$store.auth.switchTo('login')" class="text-primary hover:underline cursor-pointer">{text.toLogin}</button>
        </p>
      </form>
    </template>

    <!-- Error Message -->
    <template x-if="error">
      <p class="text-error text-sm text-center mt-4" x-text="error"></p>
    </template>
  </div>
</div>
