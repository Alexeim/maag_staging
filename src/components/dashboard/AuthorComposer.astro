---
import Button from "@/components/common/Button.astro";
import { CloudUpload, Globe } from "@lucide/astro";

interface Props {
  heading: string;
  submitLabel: string;
  authorCreatorState: string;
  cancelHref?: string;
  deleteAuthorId?: string | null;
  deleteRedirect?: string;
}

const {
  heading,
  submitLabel,
  authorCreatorState,
  cancelHref = "/dashboard/authors",
  deleteAuthorId,
  deleteRedirect = "/dashboard/authors",
} = Astro.props as Props;
---

<div
  class="max-w-4xl mx-auto"
  x-data={`$lazy('authorCreator', ${authorCreatorState})`}
>
  <h1 class="text-3xl font-bold mb-6">{heading}</h1>

  <!-- Main info -->
  <section
    class="mb-6 p-6 bg-base-100 border border-base-300 rounded-xl shadow-sm"
  >
    <h2 class="text-xl font-semibold mb-4">Основная информация</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-base-content mb-2"
          >Имя</label
        >
        <input
          type="text"
          x-model="author.firstName"
          class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
          placeholder="Имя автора"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-base-content mb-2"
          >Фамилия</label
        >
        <input
          type="text"
          x-model="author.lastName"
          class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
          placeholder="Фамилия автора"
        />
      </div>
    </div>

    <template x-if="isEditMode && authorRole">
      <div class="mt-4">
        <label class="block text-sm font-medium text-base-content mb-2"
          >Роль</label
        >
        <span
          class="inline-flex items-center rounded-full border border-base-300 bg-base-200 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-base-content/70"
          x-text="authorRole"
        ></span>
      </div>
    </template>

    <hr class="my-6" />

    <!-- Avatar upload -->
    <label class="block text-sm font-medium text-base-content mb-2"
      >Аватар</label
    >
    <div class="flex items-center" x-data="{ fileName: '' }">
      <label
        for="author-avatar-upload"
        class="cursor-pointer text-white bg-green-700 hover:bg-green-800 focus:ring-green-300 rounded-2xl flex flex-row gap-2 items-center justify-center py-2 px-4"
      >
        <CloudUpload />
        Загрузить файл
      </label>
      <input
        id="author-avatar-upload"
        type="file"
        class="hidden"
        @change="handleAvatarUpload($event); fileName = $event.target.files[0]?.name || ''"
        accept="image/png, image/jpeg, image/webp"
      />
      <span
        x-text="fileName ? fileName : (author.avatar ? 'Аватар загружен' : 'Файл не выбран')"
        class="ml-4 text-sm text-base-content/70"></span>
    </div>
    <div x-show="uploading" class="mt-4">
      <p>Загрузка: <span x-text="uploadProgress.toFixed(2) + '%'"></span></p>
      <div class="w-full bg-base-200 rounded-full h-2">
        <div
          class="bg-primary h-2 rounded-full"
          :style="{ width: uploadProgress + '%' }"
        >
        </div>
      </div>
    </div>
    <div x-show="author.avatar && !uploading" class="mt-4">
      <img
        :src="author.avatar"
        alt="Предпросмотр аватара"
        class="rounded-full h-24 w-24 object-cover"
      />
    </div>

    <hr class="my-6" />

    <!-- Bio -->
    <label class="block text-sm font-medium text-base-content mb-2"
      >Биография</label
    >
    <textarea
      x-model="author.bio"
      rows="4"
      class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
      placeholder="Пара абзацев об авторе..."
    ></textarea>
  </section>

  <!-- Social links -->
  <section class="p-6 bg-base-100 border border-base-300 rounded-xl shadow-sm">
    <h2 class="text-xl font-semibold mb-1">Соцсети</h2>
    <p class="text-sm text-base-content/70 mb-4">
      Все поля необязательны — заполняй только то, что есть у автора.
    </p>

    <div class="space-y-3">
      <!-- Instagram -->
      <div class="flex items-center gap-3">
        <span
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-base-300 bg-base-200 text-base-content"
          title="Instagram"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.44.645-1.44 1.44s.644 1.44 1.44 1.44 1.44-.644 1.44-1.44-.644-1.44-1.44-1.44z"
            ></path>
          </svg>
        </span>
        <input
          type="url"
          x-model="author.socialLinks.instagram"
          class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
          placeholder="https://instagram.com/..."
        />
      </div>

      <!-- LinkedIn -->
      <div class="flex items-center gap-3">
        <span
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-base-300 bg-base-200 text-base-content"
          title="LinkedIn"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path>
          </svg>
        </span>
        <input
          type="url"
          x-model="author.socialLinks.linkedin"
          class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
          placeholder="https://linkedin.com/in/..."
        />
      </div>

      <!-- Facebook -->
      <div class="flex items-center gap-3">
        <span
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-base-300 bg-base-200 text-base-content"
          title="Facebook"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
            ></path>
          </svg>
        </span>
        <input
          type="url"
          x-model="author.socialLinks.facebook"
          class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
          placeholder="https://facebook.com/..."
        />
      </div>

      <!-- Telegram -->
      <div class="flex items-center gap-3">
        <span
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-base-300 bg-base-200 text-base-content"
          title="Telegram"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.244-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
            ></path>
          </svg>
        </span>
        <input
          type="url"
          x-model="author.socialLinks.telegram"
          class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
          placeholder="https://t.me/..."
        />
      </div>

      <!-- Site -->
      <div class="flex items-center gap-3">
        <span
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-base-300 bg-base-200 text-base-content"
          title="Сайт"
        >
          <Globe class="h-4 w-4" />
        </span>
        <input
          type="url"
          x-model="author.socialLinks.site"
          class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
          placeholder="https://..."
        />
      </div>
    </div>
  </section>

  <!-- Actions -->
  <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex gap-2">
      {
        deleteAuthorId && (
          <Button variant="error" @click={`deleteAuthor('${deleteRedirect}')`}>
            Удалить автора
          </Button>
        )
      }
    </div>
    <div class="flex justify-end gap-3">
      {cancelHref && <Button href={cancelHref} variant="accent">Отмена</Button>}
      <Button
        variant="primary"
        @click="saveAuthor()"
        :disabled="isSaving"
        :class="{ 'opacity-50 cursor-not-allowed': isSaving }"
      >
        {submitLabel}
      </Button>
    </div>
  </div>
</div>
