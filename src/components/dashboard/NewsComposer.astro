---
import Button from "@/components/common/Button.astro";
import { CloudUpload } from "@lucide/astro";
import RelatedContentEditor from "@/components/dashboard/RelatedContentEditor.astro";
import ContentCollectionsEditor from "@/components/dashboard/ContentCollectionsEditor.astro";
import PublicationStatusBanner from "@/components/dashboard/PublicationStatusBanner.astro";
import DashboardMaterialActionFooter from "@/components/dashboard/DashboardMaterialActionFooter.astro";

interface Props {
  heading: string;
  submitLabel: string;
  newsCreatorState: string;
  cancelHref?: string;
  deleteArticleId?: string | null;
  deleteRedirect?: string;
}

const {
  heading,
  submitLabel,
  newsCreatorState,
  cancelHref,
  deleteArticleId,
  deleteRedirect = "/dashboard/news",
} = Astro.props as Props;
---

<div
  class="max-w-4xl mx-auto"
  x-data={`$lazy('newsCreator', ${newsCreatorState})`}
>
  <h1 class="text-3xl font-bold mb-6">{heading}</h1>
  <PublicationStatusBanner model="article" />

  <!-- Main info section -->
  <section
    class="mb-6 p-6 bg-base-100 border border-base-300 rounded-xl shadow-sm"
  >
    <h2 class="text-xl font-semibold mb-4">Основная информация</h2>

    <label class="block text-sm font-medium text-base-content mb-2"
      >Заголовок новости</label
    >
    <template x-if="isEditingTitle">
      <div>
        <input
          type="text"
          x-model="editingTitleText"
          class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
        />
        <div class="flex justify-end gap-3 mt-3">
          <Button variant="secondary" size="sm" x-on:click="cancelEditTitle()"
            >Отмена</Button
          >
          <Button variant="primary" size="sm" x-on:click="saveTitle()"
            >Сохранить</Button
          >
        </div>
      </div>
    </template>
    <template x-if="!isEditingTitle">
      <div
        class="flex justify-between items-center border border-base-300 rounded-lg px-4 py-3"
      >
        <h3
          class="text-lg font-semibold"
          x-text="article.title || 'Введите заголовок...'"
        >
        </h3>
        <Button variant="outline" size="sm" x-on:click="editTitle()"
          >Редактировать</Button
        >
      </div>
    </template>

    <div class="mt-4">
      <label class="block text-sm font-medium text-base-content mb-2"
        >Главный абзац (лид)</label
      >
      <template x-if="!isLazyLoading">
        <div
          class="rich-text-editor rich-text-editor--compact"
          x-data="blockRichTextEditor({ initialHtml: getRichTextInitialHtml({ html: article.leadHtml, text: article.lead }), placeholder: 'Текст, который отображается рядом с картинкой в шапке новости...' })"
          x-on:rich-text-change="article.leadHtml = $event.detail.html; article.lead = $event.detail.text"
        >
          <div x-ref="editor"></div>
        </div>
      </template>
    </div>

    <div class="mt-4">
      <label class="block text-sm font-medium text-base-content mb-2"
        >Заголовок для карточки</label
      >
      <input
        type="text"
        x-model="article.cardTitle"
        class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
        placeholder="Если не заполнить, на карточках будет показан обычный заголовок новости..."
      />
    </div>

    <div class="mt-4">
      <label class="block text-sm font-medium text-base-content mb-2"
        >Лид для карточки</label
      >
      <textarea
        x-model="article.cardLead"
        rows="2"
        class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
        placeholder="Короткий текст для карточек на лендинге и страницах категорий..."
      ></textarea>
    </div>

    <div class="mt-6 space-y-3">
      <label class="block text-sm font-medium text-base-content">Автор</label>

      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          x-on:click="useNewAuthor = false"
          class="px-3 py-2 border text-sm cursor-pointer"
          x-bind:class="!useNewAuthor ? 'bg-primary text-primary-content border-primary' : 'bg-base-100 border-base-300 text-base-content'"
        >
          Выбрать из списка
        </button>
        <button
          type="button"
          x-on:click="useNewAuthor = true"
          class="px-3 py-2 border text-sm cursor-pointer"
          x-bind:class="useNewAuthor ? 'bg-primary text-primary-content border-primary' : 'bg-base-100 border-base-300 text-base-content'"
        >
          Новый автор
        </button>
      </div>

      <div x-show="!useNewAuthor">
        <select
          x-model="selectedAuthorId"
          class="bg-base-100 border border-base-300 text-base-content text-sm focus:ring-primary focus:border-primary block w-full p-2.5 cursor-pointer"
        >
          <option value="">Выберите автора...</option>
          <template x-for="author in authors" x-bind:key="author.id">
            <option x-bind:value="author.id" x-text="getAuthorLabel(author)"></option>
          </template>
        </select>
        <p x-show="authorsLoading" class="text-xs text-base-content/60 mt-1">Загружаем авторов...</p>
      </div>

      <div x-show="useNewAuthor" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <input
          type="text"
          x-model="newAuthorFirstName"
          class="bg-base-100 border border-base-300 text-base-content text-sm focus:ring-primary focus:border-primary block w-full p-2.5"
          placeholder="Имя автора"
        />
        <input
          type="text"
          x-model="newAuthorLastName"
          class="bg-base-100 border border-base-300 text-base-content text-sm focus:ring-primary focus:border-primary block w-full p-2.5"
          placeholder="Фамилия автора"
        />
      </div>
    </div>

    <hr class="my-6" />

    <label
      for="news-category-select"
      class="block text-sm font-medium text-base-content mb-2">Категория</label
    >
    <select
      id="news-category-select"
      x-model="article.category"
      x-on:change="handleCategoryChange($event.target.value)"
      class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5 cursor-pointer"
    >
      <option value="" disabled>Выберите категорию...</option>
      <option value="culture">Культура</option>
      <option value="paris">Париж</option>
    </select>


    <!-- Tags -->
    <div class="mt-6">
      <label class="block text-sm font-medium text-base-content mb-3"
        >Теги</label
      >

      <template x-if="getAvailableTags().length > 0">
        <div class="flex flex-wrap gap-2">
          <template x-for="tag in getAvailableTags()" x-bind:key="tag">
            <button
              type="button"
              class="px-4 py-2 rounded-full border text-sm transition cursor-pointer"
              x-bind:class="isTagSelected(tag) ? 'bg-primary text-primary-content border-primary' : 'bg-base-100 text-base-content border-base-300 hover:bg-base-200'"
              x-on:click="toggleTag(tag)"
            >
              <span x-text="tag"></span>
            </button>
          </template>
        </div>
      </template>

      <div class="mt-3 flex flex-col gap-3">
        <template x-if="article.tags.length > 0">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-base-content/60">
              Категорийные теги
            </p>
            <div class="flex flex-wrap gap-2 mt-1">
              <template x-for="tag in article.tags" x-bind:key="tag">
                <span
                  class="inline-flex items-center gap-2 px-3 py-1 bg-base-200 rounded-full text-sm"
                >
                  <span x-text="tag"></span>
                  <button
                    type="button"
                    class="text-base-content/60 hover:text-base-content cursor-pointer"
                    x-on:click="removeTag(tag)"
                  >
                    &times;
                  </button>
                </span>
              </template>
            </div>
          </div>
        </template>

      </div>
    </div>

    <hr class="my-6" />

    <!-- Cover image upload -->
    <label class="block text-sm font-medium text-base-content mb-2"
      >Обложка новости</label
    >
    <div class="flex items-center" x-data="{ fileName: '' }">
      <label
        for="news-file-upload"
        class="cursor-pointer text-white bg-green-700 hover:bg-green-800 focus:ring-green-300 rounded-2xl flex flex-row gap-2 items-center justify-center py-2 px-4"
      >
        <CloudUpload />
        Загрузить файл
      </label>
      <input
        id="news-file-upload"
        type="file"
        class="hidden"
        x-on:change="handleImageUpload($event); fileName = $event.target.files[0]?.name || ''"
        accept="image/png, image/jpeg, image/webp"
      />
      <span
        x-text="fileName ? fileName : (article.imageUrl ? 'Изображение загружено' : 'Файл не выбран')"
        class="ml-4 text-sm text-base-content/70"></span>
    </div>
    <div x-show="uploading" class="mt-4">
      <p>Загрузка: <span x-text="uploadProgress.toFixed(2) + '%'"></span></p>
      <div class="w-full bg-base-200 rounded-full h-2">
        <div
          class="bg-primary h-2 rounded-full"
          x-bind:style="{ width: uploadProgress + '%' }"
        >
        </div>
      </div>
    </div>
    <div x-show="article.imageUrl && !uploading" class="mt-4 space-y-4">
      <p class="text-sm text-success">Обложка загружена!</p>
      <img
        x-bind:src="article.imageUrl"
        alt="Предпросмотр обложки"
        class="rounded-md max-h-60 w-full object-cover"
      />
      <div>
        <label class="block text-sm font-medium text-base-content mb-2"
          >Подпись к изображению</label
        >
        <template x-if="isEditingCaption">
          <div>
            <input
              type="text"
              x-model="editingCaptionText"
              class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
              placeholder="Введите подпись..."
            />
            <div class="flex justify-end gap-3 mt-3">
              <Button variant="secondary" size="sm" x-on:click="cancelEditCaption()"
                >Отмена</Button
              >
              <Button variant="primary" size="sm" x-on:click="saveCaption()"
                >Сохранить</Button
              >
            </div>
          </div>
        </template>
        <template x-if="!isEditingCaption">
          <div
            class="flex justify-between items-center border border-base-300 rounded-lg px-4 py-3"
          >
            <p
              class="text-base-content"
              x-text="article.imageCaption || 'Подпись отсутствует...'"
            >
            </p>
            <Button variant="outline" size="sm" x-on:click="editCaption()"
              >Редактировать</Button
            >
          </div>
        </template>
      </div>
    </div>
  </section>

  <!-- Content blocks (paragraph only) -->
  <section class="p-6 bg-base-100 border border-base-300 rounded-xl shadow-sm">
    <h2 class="text-xl font-semibold mb-4">Содержание новости</h2>
    <div class="space-y-4">
      <template x-for="(block, index) in article.contentBlocks" x-bind:key="block.id || index">
        <div
          class="p-4 border border-base-300 rounded-lg bg-base-100 relative group transition-colors"
          x-bind:class="{
            'cursor-grab': editingIndex === null,
            'cursor-default': editingIndex !== null,
            'opacity-60': draggedBlockId === block.id,
            'border-primary ring-2 ring-primary/20': dragOverBlockId === block.id && draggedBlockId !== block.id
          }"
          x-bind:draggable="editingIndex === null"
          x-on:dragstart="startBlockDrag(index)"
          x-on:dragenter.prevent="setBlockDropTarget(index)"
          x-on:dragover.prevent="setBlockDropTarget(index)"
          x-on:drop.prevent="dropBlock(index)"
          x-on:dragend="resetBlockDrag()"
        >
          <template x-if="editingIndex === index">
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-3">
                <p class="text-xs uppercase tracking-[0.2em] text-base-content/50" x-text="'Позиция: ' + ((block.position ?? index) + 1)"></p>
                <p class="text-xs text-base-content/50">Во время редактирования перетаскивание выключено</p>
              </div>
              <h3 class="text-lg font-semibold capitalize" x-text="getBlockTypeLabel(editingBlock.type)"></h3>

              <template x-if="editingBlock.type === 'paragraph'">
                <div
                  class="rich-text-editor"
                  x-data="blockRichTextEditor({ initialHtml: getRichTextInitialHtml(editingBlock), placeholder: 'Введите текст абзаца...' })"
                  x-on:rich-text-change="editingBlock.html = $event.detail.html; editingBlock.text = $event.detail.text"
                >
                  <div x-ref="editor"></div>
                </div>
              </template>

              <template x-if="editingBlock.type === 'image'">
                <div x-data="{ blockFileName: '' }" class="space-y-3">
                  <label class="block text-sm font-medium">Изображение</label>
                  <div class="flex items-center gap-3">
                    <label
                      x-bind:for="'block-image-upload-' + index"
                      class="cursor-pointer text-white bg-green-700 hover:bg-green-800 focus:ring-green-300 rounded-2xl flex flex-row gap-2 items-center justify-center py-2 px-4"
                    >
                      <CloudUpload />
                      Загрузить файл
                    </label>
                    <input
                      x-bind:id="'block-image-upload-' + index"
                      type="file"
                      class="hidden"
                      x-on:change="handleImageUpload($event, false); blockFileName = $event.target.files[0]?.name || ''"
                      accept="image/png, image/jpeg, image/webp"
                    />
                    <span
                      x-text="blockFileName || (editingBlock.url ? 'Изображение загружено' : 'Файл не выбран')"
                      class="text-sm text-base-content/70"></span>
                  </div>
                  <div x-show="uploading && editingIndex === index">
                    <p>
                      Загрузка: <span x-text="uploadProgress.toFixed(2) + '%'"
                      ></span>
                    </p>
                    <div class="w-full bg-base-200 rounded-full h-2">
                      <div
                        class="bg-primary h-2 rounded-full"
                        x-bind:style="{ width: uploadProgress + '%' }"
                      >
                      </div>
                    </div>
                  </div>
                  <img
                    x-show="editingBlock.url && !uploading"
                    x-bind:src="editingBlock.url"
                    alt="Предпросмотр блока"
                    class="rounded-md max-h-48"
                  />
                  <label class="block text-sm font-medium mt-2"
                    >Подпись к изображению</label
                  >
                  <input
                    type="text"
                    x-model="editingBlock.caption"
                    class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
                    placeholder="Введите подпись..."
                  />
                </div>
              </template>

              <template x-if="editingBlock.type === 'video'">
                <div class="space-y-4">
                  <div>
                    <label class="block text-sm font-medium mb-2">Источник видео</label>
                    <div class="flex flex-wrap gap-2">
                      <button
                        type="button"
                        class="px-3 py-2 border text-sm cursor-pointer"
                        x-bind:class="editingBlock.sourceType === 'upload' ? 'bg-primary text-primary-content border-primary' : 'bg-base-100 border-base-300 text-base-content'"
                        x-on:click="editingBlock.sourceType = 'upload'; editingBlock.provider = 'upload'"
                      >
                        Загрузить файл
                      </button>
                      <button
                        type="button"
                        class="px-3 py-2 border text-sm cursor-pointer"
                        x-bind:class="editingBlock.sourceType === 'embed' ? 'bg-primary text-primary-content border-primary' : 'bg-base-100 border-base-300 text-base-content'"
                        x-on:click="editingBlock.sourceType = 'embed'; editingBlock.provider = getVideoProvider(editingBlock.url, 'embed')"
                      >
                        Ссылка / Embed
                      </button>
                    </div>
                  </div>

                  <div x-show="editingBlock.sourceType === 'upload'" x-data="{ videoFileName: '' }" class="space-y-3">
                    <label class="block text-sm font-medium">Видео файл</label>
                    <div class="flex items-center gap-3">
                      <label
                        x-bind:for="'block-video-upload-' + index"
                        class="cursor-pointer text-white bg-green-700 hover:bg-green-800 focus:ring-green-300 rounded-2xl flex flex-row gap-2 items-center justify-center py-2 px-4"
                      >
                        <CloudUpload />
                        Загрузить видео
                      </label>
                      <input
                        x-bind:id="'block-video-upload-' + index"
                        type="file"
                        class="hidden"
                        x-on:change="handleVideoUpload($event); videoFileName = $event.target.files[0]?.name || ''"
                        accept="video/mp4,video/webm,video/quicktime"
                      />
                      <span
                        x-text="videoFileName || (editingBlock.url ? 'Видео загружено' : 'Файл не выбран')"
                        class="text-sm text-base-content/70"
                      ></span>
                    </div>
                    <div x-show="uploading && editingIndex === index">
                      <p>
                        Загрузка: <span x-text="uploadProgress.toFixed(2) + '%'"></span>
                      </p>
                      <div class="w-full bg-base-200 rounded-full h-2">
                        <div
                          class="bg-primary h-2 rounded-full"
                          x-bind:style="{ width: uploadProgress + '%' }"
                        ></div>
                      </div>
                    </div>
                    <video
                      x-show="editingBlock.url && !uploading"
                      x-bind:src="editingBlock.url"
                      controls
                      playsinline
                      class="rounded-md max-h-48 w-full bg-black"
                    ></video>
                  </div>

                  <div x-show="editingBlock.sourceType === 'embed'" class="space-y-3">
                    <label class="block text-sm font-medium">Ссылка на видео или embed URL</label>
                    <input
                      type="url"
                      x-model="editingBlock.url"
                      x-on:input="editingBlock.provider = getVideoProvider(editingBlock.url, 'embed')"
                      class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
                      placeholder="https://player.example.com/embed/123 или https://cdn.example.com/video.mp4"
                    />
                    <p class="text-xs text-base-content/60">
                      Поддерживаются YouTube/Vimeo, готовые embed-ссылки и прямые ссылки на видеофайлы.
                    </p>
                    <p class="text-xs text-base-content/50">
                      Обычная страница с видео не подойдёт: нужна либо прямая ссылка на файл, либо готовая ссылка для встраивания.
                    </p>
                    <video
                      x-show="getVideoDirectUrl(editingBlock.url)"
                      x-bind:src="getVideoDirectUrl(editingBlock.url)"
                      controls
                      playsinline
                      class="rounded-md max-h-48 w-full bg-black"
                    ></video>
                    <div
                      x-show="getVideoEmbedUrl(editingBlock.url)"
                      class="w-full aspect-video rounded-md overflow-hidden bg-black"
                    >
                      <iframe
                        x-bind:src="getVideoEmbedUrl(editingBlock.url)"
                        class="w-full h-full border-0"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                      ></iframe>
                    </div>
                  </div>

                  <div>
                    <label class="block text-sm font-medium mt-2">Подпись к видео</label>
                    <input
                      type="text"
                      x-model="editingBlock.caption"
                      class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
                      placeholder="Введите подпись..."
                    />
                  </div>
                </div>
              </template>

              <template x-if="editingBlock.type === 'tweet'">
                <div class="space-y-3">
                  <label class="block text-sm font-medium">Ссылка на твит</label>
                  <input
                    type="url"
                    x-model="editingBlock.url"
                    class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
                    placeholder="https://x.com/user/status/1234567890123456789"
                  />
                  <p
                    x-show="editingBlock.url && !getTweetId(editingBlock.url)"
                    class="text-sm text-error"
                  >
                    Это не похоже на ссылку на конкретный твит. Нужен вид twitter.com/user/status/123 или x.com/user/status/123.
                  </p>
                  <p
                    x-show="editingBlock.url && getTweetId(editingBlock.url)"
                    class="text-sm text-success"
                  >
                    Ссылка распознана, твит подставится на странице новости.
                  </p>
                </div>
              </template>

              <template x-if="editingBlock.type === 'link'">
                <div class="space-y-4">
                  <div>
                    <label class="block text-sm font-medium">Тип контента</label>
                    <select
                      x-model="editingBlock.linkedContentType"
                      x-on:change="editingBlock.linkedContentId = ''"
                      class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
                    >
                      <template x-for="type in materialLinkTypeOptions" x-bind:key="type.value">
                        <option x-bind:value="type.value" x-text="type.label"></option>
                      </template>
                    </select>
                  </div>
                  <div x-show="editingBlock.linkedContentType">
                    <label class="block text-sm font-medium">Выберите контент</label>
                    <select
                      x-model="editingBlock.linkedContentId"
                      class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
                    >
                      <option value="" disabled>Выберите...</option>
                      <template x-for="item in getFilteredContentList(editingBlock.linkedContentType)" x-bind:key="item.id">
                        <option x-bind:value="item.id" x-text="item.title"></option>
                      </template>
                    </select>
                  </div>
                </div>
              </template>

              <template x-if="editingBlock.type === 'url-link'">
                <div class="space-y-4">
                  <div>
                    <label class="block text-sm font-medium">Текст ссылки</label>
                    <input
                      type="text"
                      x-model="editingBlock.text"
                      class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
                      placeholder="Например: Купить билеты..."
                    />
                  </div>
                  <div>
                    <label class="block text-sm font-medium">URL</label>
                    <input
                      type="url"
                      x-model="editingBlock.url"
                      class="bg-base-100 border border-base-300 text-base-content text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
                      placeholder="https://..."
                    />
                  </div>
                </div>
              </template>

              <div class="flex justify-end gap-3">
                <Button variant="secondary" x-on:click="cancelEdit()">Отмена</Button>
                <Button variant="primary" x-on:click="updateBlock()">Сохранить блок</Button>
              </div>
            </div>
          </template>

          <template x-if="editingIndex !== index">
            <div class="space-y-4">
              <div class="flex items-start gap-3 pr-40">
                <span class="text-base-content/40 select-none shrink-0" aria-hidden="true">⋮⋮</span>
                <div class="min-w-0 flex-1 space-y-2">
                  <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.2em] text-base-content/60">
                    <span x-text="'Позиция: ' + ((block.position ?? index) + 1)"></span>
                    <span>Перетащи, чтобы изменить порядок</span>
                  </div>
                  <div class="flex flex-wrap items-center gap-2">
                    <span
                      class="inline-flex items-center rounded-full border border-primary bg-primary px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-primary-content shadow-sm"
                      x-text="getBlockTypeLabel(block.type)"
                    ></span>
                  </div>
                </div>
              </div>
              <template x-if="block.type === 'paragraph'">
                <div class="article-rich-text text-base" x-html="getRichTextInitialHtml(block)"></div>
              </template>
              <template x-if="block.type === 'image'">
                <figure class="space-y-2">
                  <img
                    x-show="block.url"
                    x-bind:src="block.url"
                    alt="Содержимое новости"
                    class="rounded-md w-full object-cover"
                  />
                  <div
                    x-show="!block.url"
                    class="rounded-md border border-dashed border-base-300 bg-base-200/60 px-4 py-8 text-center text-sm text-base-content/60"
                  >
                    Изображение ещё не загружено
                  </div>
                  <figcaption
                    x-show="block.caption"
                    class="text-center text-sm text-base-content/60 mt-2"
                    x-text="block.caption"
                  >
                  </figcaption>
                </figure>
              </template>
              <template x-if="block.type === 'video'">
                <figure class="space-y-2">
                  <video
                    x-show="block.sourceType === 'upload' && block.url"
                    x-bind:src="block.url"
                    controls
                    playsinline
                    class="rounded-md w-full max-h-64 bg-black"
                  ></video>
                  <video
                    x-show="block.sourceType === 'embed' && getVideoDirectUrl(block.url)"
                    x-bind:src="getVideoDirectUrl(block.url)"
                    controls
                    playsinline
                    class="rounded-md w-full max-h-64 bg-black"
                  ></video>
                  <div
                    x-show="block.sourceType === 'embed' && getVideoEmbedUrl(block.url)"
                    class="w-full aspect-video rounded-md overflow-hidden bg-black"
                  >
                    <iframe
                      x-bind:src="getVideoEmbedUrl(block.url)"
                      class="w-full h-full border-0"
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    ></iframe>
                  </div>
                  <figcaption
                    x-show="block.caption"
                    class="text-center text-sm text-base-content/60 mt-2"
                    x-text="block.caption"
                  ></figcaption>
                </figure>
              </template>
              <template x-if="block.type === 'tweet'">
                <div>
                  <div
                    x-show="block.url"
                    class="rounded-md border border-base-300 bg-base-200/40 px-4 py-3 text-sm break-all"
                  >
                    <span class="text-base-content/60">Твит: </span>
                    <a
                      x-bind:href="block.url"
                      x-text="block.url"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary underline"
                    ></a>
                  </div>
                  <div
                    x-show="!block.url"
                    class="rounded-md border border-dashed border-base-300 bg-base-200/60 px-4 py-8 text-center text-sm text-base-content/60"
                  >
                    Ссылка на твит ещё не добавлена
                  </div>
                </div>
              </template>
              <template x-if="block.type === 'link'">
                <div class="rounded-lg border border-base-300 bg-base-200/40 p-4 space-y-2">
                  <p
                    class="text-xs uppercase tracking-[0.2em] text-base-content/60"
                    x-text="getLinkedContentTypeLabel(block.linkedContentType)"
                  ></p>
                  <p
                    class="text-sm font-medium text-base-content"
                    x-text="getLinkedBlockTitle(block) || 'Контент не выбран'"
                  ></p>
                  <p
                    x-show="block.linkedContentId"
                    class="text-xs text-base-content/60 break-all"
                    x-text="block.linkedContentId"
                  ></p>
                </div>
              </template>
              <template x-if="block.type === 'url-link'">
                <p class="rounded-lg border border-base-300 bg-base-200/40 p-4 text-sm">
                  <span class="font-medium" x-text="block.text || '(без текста)'"></span>
                  <span class="text-base-content/50 ml-2" x-text="block.url"></span>
                </p>
              </template>
              <div
                class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity flex gap-2"
              >
                <Button variant="outline" size="sm" x-on:click="editBlock(index)">Редактировать</Button>
                <Button variant="error" size="sm" x-on:click="deleteBlock(index)">Удалить</Button>
              </div>
            </div>
          </template>
        </div>
      </template>
    </div>

    <div class="mt-6">
      <template x-if="showBlockOptions">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 p-4 border border-base-300 rounded-lg bg-base-100">
          <button x-on:click="addBlock('paragraph')" class="p-2 rounded-lg cursor-pointer text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-gray-100">Абзац</button>
          <button x-on:click="addBlock('image')" class="p-2 rounded-lg cursor-pointer text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-gray-100">Картинка</button>
          <button x-on:click="addBlock('video')" class="p-2 rounded-lg cursor-pointer text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-gray-100">Видео</button>
          <button x-on:click="addBlock('tweet')" class="p-2 rounded-lg cursor-pointer text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-gray-100">Твит</button>
          <button x-on:click="addBlock('link')" class="p-2 rounded-lg cursor-pointer text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-gray-100">Блок-ссылка</button>
          <button x-on:click="addBlock('url-link')" class="p-2 rounded-lg cursor-pointer text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-gray-100">Ссылка на URL</button>
        </div>
      </template>
      <div x-show="!showBlockOptions" class="text-center">
        <Button variant="primary" x-on:click="openBlockSelector()">+ Добавить блок</Button>
      </div>
    </div>
  </section>

  <!-- Actions -->
  <ContentCollectionsEditor />
  <RelatedContentEditor />

  <DashboardMaterialActionFooter
    cancelHref={cancelHref}
    deleteAction="deleteArticle(deleteRedirect)"
    deleteLabel="Удалить новость"
    previewAction="previewArticle()"
    publishedModel="article"
    saveAction="saveArticle()"
    saveDisabled="isSaving"
    saveLabel={submitLabel}
    showDelete={Boolean(deleteArticleId)}
  />
</div>
