---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ArticleMetaRow from "@/components/article/ArticleMetaRow.astro";
import ImageCaptionHint from "@/components/common/ImageCaptionHint.astro";
import ContentActions from "@/components/common/ContentActions.astro";
import type { BookmarkContentType } from "@/lib/api/api";
import { getInitialRichTextHtml, richTextHtmlToText } from "@/lib/utils/richText";

interface Props {
  category: string;
  categoryHref?: string | null;
  title: string;
  interviewee: string;
  mainQuote: string;
  lead?: string;
  leadHtml?: string;
  authorName: string;
  authorAvatar?: string;
  createdAt: string | Date | { toDate: () => Date } | { _seconds: number };
  imageUrl?: ImageMetadata | string;
  imageAlt?: string;
  imageCaption?: string;
  transitionName?: string;
  heroOrientation?: "image-left" | "image-right";
  actions?: {
    contentType: BookmarkContentType;
    contentId: string;
    href: string;
    category?: string;
    tag?: string;
  };
}

const {
  category,
  categoryHref = null,
  title,
  interviewee,
  mainQuote,
  lead,
  leadHtml,
  authorName,
  authorAvatar,
  createdAt,
  imageUrl,
  imageAlt = "Interview image",
  imageCaption,
  transitionName,
  heroOrientation = "image-left",
  actions,
} = Astro.props;

const isLongTitle = title.trim().split(/\s+/).filter(Boolean).length > 3;
const imageOnLeft = heroOrientation === "image-left";
const resolvedImageUrl = typeof imageUrl === "string" ? imageUrl : imageUrl?.src;
const resolvedLeadHtml = getInitialRichTextHtml({ html: leadHtml, text: lead });
// Long leads blow past the hero's fixed 100svh height on desktop, so we scale
// the font down once the lead outgrows a comfortable couple of sentences.
const isLongLead = richTextHtmlToText(resolvedLeadHtml).length > 320;
---

<section class="w-full px-4 sm:px-6 lg:px-10">
  <div class="overflow-visible lg:h-[calc(100svh-90px)]">
    <div
      class:list={[
        "grid h-auto gap-8 lg:h-full lg:grid-rows-1 lg:gap-0 lg:items-stretch",
        imageUrl
          ? "lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)]"
          : "grid-cols-1",
      ]}
    >
      {
        imageUrl && (
          <div class:list={["flex flex-col lg:h-full lg:min-h-0", imageOnLeft ? "order-2 lg:order-1" : "order-2 lg:order-2"]}>
            <div class="flex items-center justify-center overflow-hidden lg:min-h-0 lg:flex-1">
              <div class="group relative w-full lg:h-full lg:w-auto" x-data="{ open: false }" @click="open = !open">
                {typeof imageUrl === "string" ? (
                  <img
                    src={imageUrl}
                    alt={imageAlt}
                    class="block h-auto w-full object-cover lg:h-full lg:w-auto lg:max-w-full lg:object-cover"
                    transition:name={transitionName}
                  />
                ) : (
                  <Image
                    src={imageUrl}
                    alt={imageAlt}
                    class="block h-auto w-full object-cover lg:h-full lg:w-auto lg:max-w-full lg:object-cover"
                    transition:name={transitionName}
                  />
                )}
                {imageCaption && <ImageCaptionHint caption={imageCaption} />}
              </div>
            </div>
          </div>
        )
      }

      <div
        class:list={[
          "flex flex-col justify-center px-2 py-8 text-center text-base-content sm:px-6 sm:py-10 lg:h-full lg:px-16 lg:py-12",
          imageOnLeft ? "order-1 lg:order-2" : "order-1 lg:order-1",
        ]}
      >
        {categoryHref ? (
          <a
            href={categoryHref}
            class="font-['Inter'] text-xs font-bold uppercase tracking-[0.25em] text-accent hover:underline"
          >
            {category}
          </a>
        ) : (
          <p
            class="font-['Inter'] text-xs font-bold uppercase tracking-[0.25em] text-accent"
          >
            {category}
          </p>
        )}
        <h1
          class:list={[
            "mt-8 font-old_standard font-semibold leading-[1.05] text-base-content",
            isLongTitle ? "text-4xl lg:text-5xl" : "text-5xl lg:text-7xl",
          ]}
        >
          {interviewee}:
        </h1>
        <h2
          class:list={[
            "font-old_standard font-normal italic leading-[1.05] text-base-content",
            isLongTitle ? "text-4xl lg:text-5xl" : "text-5xl lg:text-7xl",
          ]}
        >
          "{mainQuote}"
        </h2>
        {
          resolvedLeadHtml && (
            <div
              class:list={[
                "article-rich-text mx-auto mt-8 max-w-[34rem] font-article-body font-light text-base-content lg:mt-10",
                isLongLead ? "text-[15px]" : "text-base",
              ]}
              set:html={resolvedLeadHtml}
            />
          )
        }
        <div
          class="mt-8 flex flex-col items-center justify-center gap-4 text-base-content lg:mt-10"
        >
          <ArticleMetaRow
            authorName={authorName}
            authorAvatar={authorAvatar}
            createdAt={createdAt}
            align="center"
          />
          {actions && (
            <ContentActions
              contentType={actions.contentType}
              contentId={actions.contentId}
              title={title}
              href={actions.href}
              category={actions.category}
              tag={actions.tag}
              imageUrl={resolvedImageUrl}
              align="center"
            />
          )}
        </div>
      </div>
    </div>
  </div>
  <hr class="mt-10 w-full border-t border-neutral-200 lg:mt-16" />
</section>
