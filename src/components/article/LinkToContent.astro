---
import type { PublicContentCardItem } from "@/lib/utils/contentCollectionMarquee";
import { getPrimaryBadgeLabel } from "@/lib/utils/contentBadge";
import ReadMoreButton from "../common/ReadMoreButton.astro";

interface Props {
  item: PublicContentCardItem;
}

const { item } = Astro.props as Props;

const isInterview = item.contentType === "interview";
const imageSrc = item.imageUrl || "";
const lead = item.cardLead || item.lead || item.mainQuote || "";
const title = item.cardTitle || item.title;
const label = getPrimaryBadgeLabel(item);
---

<article class="border-y border-base-content/30 py-4">
  <a
    href={item.href}
    class="group flex items-start gap-4 text-current no-underline relative"
    aria-label={title}
  >
    <div
      class:list={[
        "overflow-hidden bg-base-200 flex-shrink-0",
        isInterview ? "h-36 w-36 rounded-full" : "h-36 w-36",
      ]}
    >
      {
        imageSrc ? (
          <img
            src={imageSrc}
            alt={title}
            class:list={[
              "h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]",
              isInterview && "rounded-full",
            ]}
            loading="lazy"
          />
        ) : (
          <div
            class:list={[
              "h-full w-full bg-base-content/5",
              isInterview && "rounded-full",
            ]}
            aria-hidden="true"
          />
        )
      }
    </div>

    <div class="min-w-0 flex-1">
      <p class="mb-1">
        <span
          class="font-['Inter'] text-[.6rem] lg:text-xs font-bold uppercase tracking-[0.25em] text-accent"
        >
          {label}
        </span>
      </p>

      <h3
        class="font-old_standard text-[1.3rem] lg:text-3xl leading-[1.05] font-normal tracking-[-0.02em] transition-opacity duration-200 group-hover:underline"
      >
        {title}
      </h3>

      <!-- {
        lead && (
          <p class="mt-2 line-clamp-3 font-inter text-sm leading-snug text-base-content/65">
            {lead}
          </p>
        )
      } -->
    </div>
    <div
      class="inline-flex w-fit items-center border border-base-content px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.2em] font-['Inter'] text-base-content no-underline transition-colors hover:bg-base-content hover:text-base-200 absolute right-0 bottom-0"
    >
      <span>Читать дальше</span>
    </div>
  </a>
</article>
