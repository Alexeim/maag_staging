---
import LazyImage from "../common/LazyImage.astro";

interface Props {
  portraitImageUrl?: string;
  portraitImageCaption?: string;
  landscapeImageUrl?: string;
  landscapeImageCaption?: string;
}

const {
  portraitImageUrl = "",
  portraitImageCaption = "",
  landscapeImageUrl = "",
  landscapeImageCaption = "",
} = Astro.props as Props;
---

<!--
  Desktop layout depends on width only: the landscape image starts at the
  portrait's vertical midpoint. Percentage margins on flex items resolve
  against the container width, so 16.5929% = 22.1239% * (3/2) / 2.
-->
<section class="w-full h-auto lg:flex lg:items-start lg:max-w-[1356px]">
  {
    portraitImageUrl && (
      <figure class="w-full lg:shrink-0 lg:w-[22.1239%]">
        <LazyImage
          src={portraitImageUrl}
          alt={portraitImageCaption || "Portrait article image"}
          class="block w-full aspect-[2/3] object-cover"
          loading="lazy"
        />
        {portraitImageCaption && (
          <figcaption class="mt-2 text-xs font-inter text-base-content/55">
            {portraitImageCaption}
          </figcaption>
        )}
      </figure>
    )
  }

  {
    landscapeImageUrl && (
      <figure class="mt-4 w-full lg:shrink-0 lg:ml-auto lg:mt-[16.5929%] lg:w-[77.8761%]">
        <LazyImage
          src={landscapeImageUrl}
          alt={landscapeImageCaption || "Landscape article image"}
          class="block w-full aspect-[16/9] object-cover"
          loading="lazy"
        />
        {landscapeImageCaption && (
          <figcaption class="mt-2 text-xs font-inter text-base-content/55">
            {landscapeImageCaption}
          </figcaption>
        )}
      </figure>
    )
  }
</section>
