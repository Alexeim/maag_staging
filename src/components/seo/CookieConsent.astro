---
// CNIL-compliant cookie consent banner (vanilla-cookieconsent v3).
//
// - Equally-weighted "accept all" / "reject all", granular preferences modal.
// - Decision persisted in the `cc_cookie` cookie (default 182 days =
//   CNIL's 6-month re-prompt).
// - GTM, Yandex Metrika and third-party embeds are gated on consent by
//   GoogleTagManager.astro / YandexMetrika.astro / TwitterWidgets.astro, listening for
//   `cc:onConsent` / `cc:onChange` events this component dispatches.
//
// Astro view transitions (useClientRouter) swap <body>, which destroys the
// #cc-main container and every listener the library attached to `data-cc`
// triggers (e.g. the footer "cookie settings" button). So the instance is
// torn down before each swap and rebuilt against the fresh DOM afterwards.
import "vanilla-cookieconsent/dist/cookieconsent.css";
---

<script>
  import * as CookieConsent from "vanilla-cookieconsent";

  // Ask again when analytics providers or their disclosed features change.
  const CONSENT_REVISION = 2;

  const config: CookieConsent.CookieConsentConfig = {
    revision: CONSENT_REVISION,

    guiOptions: {
      consentModal: {
        layout: "box",
        position: "bottom left",
        // CNIL: "accept" and "reject" must be equally prominent.
        equalWeightButtons: true,
        flipButtons: false,
      },
      preferencesModal: {
        layout: "box",
        position: "right",
        equalWeightButtons: true,
        flipButtons: false,
      },
    },

    categories: {
      // Strictly necessary — always on, cannot be toggled off.
      necessary: {
        enabled: true,
        readOnly: true,
      },
      // Google Analytics and Yandex Metrika stay off until the visitor opts in.
      // Clear their first-party cookies when consent is withdrawn.
      analytics: {
        autoClear: {
          cookies: [
            { name: /^_ga/ },
            { name: "_gid" },
            { name: "_gat" },
            { name: /^_ym_/ },
          ],
        },
      },
      // Social-media embeds (X/Twitter widgets.js, see TwitterWidgets.astro).
      // Their cookies live on the provider's domain, so there is nothing for
      // autoClear to erase from here — the gate simply stops loading the script.
      social: {},
    },

    language: {
      default: "ru",
      // Pick the translation from <html lang>, which Layout sets from the
      // page's locale. Re-read on every mount, i.e. after each page swap.
      autoDetect: "document",
      translations: {
        ru: {
          consentModal: {
            title: "Мы используем файлы cookie",
            description:
              "Обязательные cookie нужны для работы сайта. Google Analytics и Яндекс Метрика (включая Вебвизор — запись взаимодействий с сайтом) помогают понять, как читатели пользуются изданием, и подключаются только с вашего согласия.",
            acceptAllBtn: "Принять все",
            acceptNecessaryBtn: "Отклонить все",
            showPreferencesBtn: "Настроить",
            footer:
              '<a href="/privacy">Политика конфиденциальности</a>\n<a href="/cookies">Использование файлов cookie</a>',
          },
          preferencesModal: {
            title: "Настройки cookie",
            acceptAllBtn: "Принять все",
            acceptNecessaryBtn: "Отклонить все",
            savePreferencesBtn: "Сохранить выбор",
            closeIconLabel: "Закрыть",
            sections: [
              {
                title: "Использование файлов cookie",
                description:
                  "Здесь вы можете выбрать, какие категории cookie разрешить. Обязательные cookie отключить нельзя — без них сайт не работает.",
              },
              {
                title: "Обязательные cookie",
                description:
                  "Нужны для базовой работы сайта: сессия, авторизация, хранение самого факта вашего выбора по cookie.",
                linkedCategory: "necessary",
              },
              {
                title: "Аналитические cookie",
                description:
                  "Google Analytics 4 и Яндекс Метрика: статистика посещаемости и поведения на сайте. В Метрике включены карта кликов и Вебвизор — запись взаимодействий с сайтом. Эти инструменты подключаются только с вашего согласия.",
                linkedCategory: "analytics",
              },
              {
                title: "Cookie социальных сетей",
                description:
                  "Встроенные публикации из соцсетей (X/Twitter). Их провайдеры ставят свои cookie, когда пост подгружается. Без согласия вместо встроенного поста показывается цитата со ссылкой.",
                linkedCategory: "social",
              },
              {
                title: "Ещё вопросы?",
                description:
                  'Подробнее — в <a href="/cookies">описании использования cookie</a> и <a href="/privacy">политике конфиденциальности</a>.',
              },
            ],
          },
        },
        // Consent text: keep it a faithful rendering of the Russian one. The
        // legal pages it links to exist in Russian only for now.
        fr: {
          consentModal: {
            title: "Nous utilisons des cookies",
            description:
              "Les cookies obligatoires sont nécessaires au fonctionnement du site. Google Analytics et Yandex Metrica (y compris Webvisor, qui enregistre les interactions avec le site) nous aident à comprendre comment les lecteurs utilisent notre média ; ils ne sont activés qu'avec votre consentement.",
            acceptAllBtn: "Tout accepter",
            acceptNecessaryBtn: "Tout refuser",
            showPreferencesBtn: "Personnaliser",
            footer:
              '<a href="/privacy">Politique de confidentialité</a>\n<a href="/cookies">Utilisation des cookies</a>',
          },
          preferencesModal: {
            title: "Paramètres des cookies",
            acceptAllBtn: "Tout accepter",
            acceptNecessaryBtn: "Tout refuser",
            savePreferencesBtn: "Enregistrer mes choix",
            closeIconLabel: "Fermer",
            sections: [
              {
                title: "Utilisation des cookies",
                description:
                  "Vous pouvez choisir ici les catégories de cookies que vous autorisez. Les cookies obligatoires ne peuvent pas être désactivés : sans eux, le site ne fonctionne pas.",
              },
              {
                title: "Cookies obligatoires",
                description:
                  "Nécessaires au fonctionnement de base du site : session, authentification et enregistrement de votre choix concernant les cookies.",
                linkedCategory: "necessary",
              },
              {
                title: "Cookies analytiques",
                description:
                  "Google Analytics 4 et Yandex Metrica : statistiques de fréquentation et de comportement sur le site. Dans Metrica, la carte des clics et Webvisor (enregistrement des interactions avec le site) sont activés. Ces outils ne sont activés qu'avec votre consentement.",
                linkedCategory: "analytics",
              },
              {
                title: "Cookies des réseaux sociaux",
                description:
                  "Publications intégrées des réseaux sociaux (X/Twitter). Leurs fournisseurs déposent leurs propres cookies lorsque la publication se charge. Sans votre consentement, une citation avec un lien s'affiche à la place de la publication intégrée.",
                linkedCategory: "social",
              },
              {
                title: "D'autres questions ?",
                description:
                  'Pour en savoir plus, consultez notre <a href="/cookies">page sur l\'utilisation des cookies</a> et notre <a href="/privacy">politique de confidentialité</a>.',
              },
            ],
          },
        },
      },
    },
  };

  let mounted = false;

  function mount() {
    if (mounted) return;
    CookieConsent.run(config);
    mounted = true;
  }

  function unmount() {
    if (!mounted) return;
    // reset() without `true` keeps the consent cookie — only the DOM and
    // listeners are torn down.
    CookieConsent.reset(false);
    mounted = false;
  }

  mount();

  // This module runs once; the listeners below persist on `document` across
  // view transitions and drive the teardown / rebuild cycle.
  document.addEventListener("astro:before-swap", unmount);
  document.addEventListener("astro:page-load", mount);
</script>
