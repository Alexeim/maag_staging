---
import LazyImage from "./LazyImage.astro";
import { composeFirstPersonTitle } from "@/lib/utils/firstPerson";

interface FirstPersonCardProps {
  authorName?: string;
  title?: string;
  imageUrl?: string | null;
  transitionName?: string;
  href?: string;
}

const {
  authorName = "",
  title = "",
  imageUrl,
  transitionName,
  href = "#",
} = Astro.props as FirstPersonCardProps;

const imageLoading: "lazy" | "eager" = imageUrl ? "lazy" : "eager";
const composedTitle =
  composeFirstPersonTitle(authorName, title) || "Без названия";
---

<div class="linked-image-hover w-full">
  <div
    class="relative flex aspect-2/3 w-full flex-row overflow-hidden bg-base-100 border-[10px] border-gray-400"
  >
    <div class="flex w-1/6 items-start justify-center">
      <span
        class="[writing-mode:vertical-rl] rotate-180 whitespace-nowrap text-xs text-accent font-semibold uppercase tracking-[0.25em] px-4 font-['Inter']"
      >
        от первого лица
      </span>
    </div>
    <div class="w-5/6 grid grid-rows-[5fr_7fr]">
      <div class="pt-4 pr-2">
        <h2
          class="font-old_standard font-normal leading-[1.15] text-base-content text-[22px]"
        >
          {authorName && <span class="font-bold">{authorName}</span>}{
            authorName && " "
          }<span class="italic">{title}</span>
        </h2>
      </div>
      <div>
        {
          imageUrl ? (
            <LazyImage
              src={imageUrl}
              alt=""
              class="linked-image-hover__media h-full w-full object-contain object-bottom"
              loading={imageLoading}
              transitionName={transitionName}
            />
          ) : (
            <div class="h-full w-full bg-base-300" />
          )
        }
      </div>
    </div>

    <a href={href} class="absolute inset-0 z-1" aria-label={composedTitle}></a>
  </div>
</div>
