---
// Variant A — Magazine Cover: portrait image, gradient overlay, title on photo
import picture3 from "../../assets/images/article_content/par.jpeg";
import LazyImage from "./LazyImage.astro";

interface ZapisnayaKnijkaProps {
  title?: string;
  category?: string;
  categoryHref?: string | null;
  date?: string;
  hideDate?: boolean;
  lead?: string;
  imageUrl?: string;
  href?: string;
}

const {
  title = "Без названия",
  category = "Записная Книжка",
  categoryHref = null,
  lead = "",
  imageUrl,
  href = "#",
} = Astro.props as ZapisnayaKnijkaProps;

const imageLoading: "lazy" | "eager" = imageUrl ? "lazy" : "eager";
const isLongTitle = title.trim().split(/\s+/).filter(Boolean).length > 3;
---

<div class="w-full">
  <div class="relative flex aspect-[2/3] w-full flex-row bg-base-100">
    <div class="w-1/5 flex items-center justify-center">
      {
        category &&
          (categoryHref ? (
            <a
              href={categoryHref}
              class="relative z-[2] [writing-mode:vertical-rl] rotate-180 whitespace-nowrap text-xs text-accent font-semibold uppercase tracking-[0.25em] px-2 py-1 font-['Inter'] hover:underline"
            >
              {category}
            </a>
          ) : (
            <span class="[writing-mode:vertical-rl] rotate-180 whitespace-nowrap text-xs text-accent font-semibold uppercase tracking-[0.25em] px-2 py-1 font-['Inter']">
              {category}
            </span>
          ))
      }
    </div>
    <div class="grid w-4/5 grid-rows-[1fr_155px_1fr]">
      <div class="w-full overflow-hidden pt-4 pb-2">
        <h3
          class={`m-0 font-light font-old_standard tracking-[-0.02em] leading-[1.15] text-base-content ${isLongTitle ? "text-[21px]" : "text-[32px]"}`}
        >
          {title}
        </h3>
      </div>
      <div class="w-full overflow-hidden">
        <LazyImage
          src={imageUrl || picture3}
          alt={imageUrl ? title : "Editorial image"}
          class="h-full w-full object-cover object-center"
          loading={imageLoading}
        />
      </div>
      <div class="w-full overflow-hidden pt-3 pb-3">
        {
          lead && (
            <p class="m-0 text-[13px] font-inter font-normal leading-[1.4] text-neutral-400 line-clamp-5">
              {lead}
            </p>
          )
        }
      </div>
    </div>

    <a href={href} class="absolute inset-0 z-[1]" aria-label={title}></a>
  </div>
</div>
