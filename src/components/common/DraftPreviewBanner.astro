---
// Loud sticky bar shown on a public content page when an admin is previewing
// an unpublished material. Non-admins never hit this render path — the route
// returns its usual "not found" for them (see src/lib/utils/preview.ts).
interface Props {
  editHref?: string;
}

const { editHref } = Astro.props as Props;
---

<div
  class="sticky top-0 z-[60] w-full border-b border-warning-content/20 bg-warning text-warning-content"
  role="status"
>
  <div
    class="mx-auto flex max-w-[1512px] flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 py-2 text-center text-sm font-semibold"
  >
    <span class="uppercase tracking-[0.18em]">Черновик · не опубликовано</span>
    <span class="font-normal text-warning-content/80">
      Эту страницу видят только редакторы.
    </span>
    {
      editHref && (
        <a
          href={editHref}
          class="font-semibold underline underline-offset-2 hover:no-underline"
        >
          Открыть в редакторе
        </a>
      )
    }
  </div>
</div>
