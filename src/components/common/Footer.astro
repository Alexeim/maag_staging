---
// Footer for cultural media website about Paris
import InstagramLogo from "@/assets/social/new/instagram-svgrepo-com.svg";
import logoFull from "@/assets/logo/logoFull.svg";

const currentYear = new Date().getFullYear();
---

<footer class="bg-maag-gray text-white lg:h-85.75 lg:overflow-hidden" x-data>
  <div
    class="mx-auto flex h-full flex-col px-4 py-12 lg:px-12 lg:py-9"
  >
    {/* Main Footer Content */}
    <div
      class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr_1fr] gap-10 lg:gap-8 mb-10 lg:mb-0 text-center sm:text-left"
    >
      {/* Brand block */}
      <div
        class="flex flex-col items-center sm:items-start gap-5 lg:gap-3"
      >
        <img
          src={logoFull.src}
          alt="MAAG France"
          class="w-40 lg:w-36 h-auto"
        />
        <p
          class="font-old_standard text-lg lg:text-[0.95rem] leading-snug text-white"
        >
          Независимое издание<br />о культурной жизни Парижа
        </p>

        {/* Login / account button */}
        <div x-data="$lazy('navbar')" class="w-full sm:w-auto">
          <template x-if="$store.auth.isLoggedIn">
            <a
              href="/profile"
              class="inline-flex items-center justify-center rounded-md bg-maag-beige px-5 py-2.5 lg:py-2 font-inter text-sm text-maag-gray transition-colors hover:bg-maag-beige/85"
            >
              Личный кабинет
            </a>
          </template>
          <template x-if="!$store.auth.isLoggedIn">
            <button
              @click.prevent="$store.auth.openAuthModal()"
              class="inline-flex items-center justify-center rounded-md bg-maag-beige px-5 py-2.5 lg:py-2 font-inter text-sm text-maag-gray transition-colors hover:bg-maag-beige/85 cursor-pointer"
            >
              Войти в личный кабинет
            </button>
          </template>
        </div>
      </div>

      {/* Rubrics */}
      <div>
        <h3
          class="mb-6 lg:mb-4 font-inter text-xs font-medium uppercase tracking-[0.18em] text-white"
        >
          Рубрики
        </h3>
        <ul class="space-y-4 lg:space-y-2.5">
          <li>
            <a
              href="/culture"
              class="font-old_standard text-sm uppercase tracking-[0.12em] text-white transition-opacity hover:opacity-70"
              >Культура</a
            >
          </li>
          <li>
            <a
              href="/paris"
              class="font-old_standard text-sm uppercase tracking-[0.12em] text-white transition-opacity hover:opacity-70"
              >Париж</a
            >
          </li>
          <li>
            <a
              href="/calendar"
              class="font-old_standard text-sm uppercase tracking-[0.12em] text-white transition-opacity hover:opacity-70"
              >Календарь</a
            >
          </li>
        </ul>
      </div>

      {/* Contacts */}
      <div>
        <h3
          class="mb-6 lg:mb-4 font-inter text-xs font-medium uppercase tracking-[0.18em] text-white"
        >
          Контакты
        </h3>
        <div class="flex gap-4 justify-center sm:justify-start mb-6 lg:mb-4">
          <a
            href="https://www.instagram.com/stories/maag_france/"
            target="_blank"
            class="flex h-12 w-12 lg:h-11 lg:w-11 items-center justify-center rounded-full bg-white text-maag-gray transition-colors hover:bg-white/80"
            aria-label="Instagram"
          >
            <InstagramLogo class="w-6 h-6 lg:w-5 lg:h-5" />
          </a>
          <a
            href="mailto:contact@maagfrance.fr"
            class="flex h-12 w-12 lg:h-11 lg:w-11 items-center justify-center rounded-full bg-white text-maag-gray transition-colors hover:bg-white/80"
            aria-label="Написать нам"
          >
            <svg
              class="w-6 h-6 lg:w-5 lg:h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              viewBox="0 0 24 24"
            >
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
          </a>
        </div>
        <ul class="space-y-4 lg:space-y-2.5">
          <li>
            <a
              href="/about"
              class="font-old_standard text-sm uppercase tracking-[0.12em] text-white transition-opacity hover:opacity-70"
              >О проекте</a
            >
          </li>
          {/* Hidden for now — no dedicated "editor's word" page yet */}
          {/* <li>
            <a
              href="/about"
              class="font-old_standard text-sm uppercase tracking-[0.12em] text-white transition-opacity hover:opacity-70"
              >Слово редактора</a
            >
          </li> */}
        </ul>
      </div>
    </div>

    {/* Divider */}
    <hr class="border-[#cecece] mb-6 lg:mt-auto lg:mb-4" />

    {/* Bottom Footer */}
    <div
      class="flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left"
    >
      <div class="text-sm text-white font-inter font-normal">
        &copy; {currentYear} MAAG France. Все права защищены.
      </div>
      <div
        class="flex flex-col lg:flex-row gap-4 sm:gap-6 text-sm text-white font-inter font-normal"
      >
        <template x-if="$store.auth.profile?.role === 'admin'">
          <a href="/dashboard" class="transition-opacity hover:opacity-70">
            🚧 Для Администрации 🚧
          </a>
        </template>
        <a href="/privacy" class="transition-opacity hover:opacity-70"
          >Политика конфиденциальности</a
        >
        <a href="/terms" class="transition-opacity hover:opacity-70"
          >Пользовательское соглашение</a
        >
        <a href="/cookies" class="transition-opacity hover:opacity-70"
          >Использование файлов cookie</a
        >
        <button
          type="button"
          data-cc="show-preferencesModal"
          class="cursor-pointer border-0 bg-transparent p-0 font-inter text-sm text-white transition-opacity hover:opacity-70"
          >Настройки cookie</button
        >
      </div>
    </div>
  </div>
</footer>
