---
import logo from "../../assets/logo/logo.svg";
import { Search, X } from "@lucide/astro";
import { Image } from "astro:assets";
import InstagramLogo from "@/assets/social/new/instagram-svgrepo-com.svg";
import burgerIcon from "../../assets/icons/burger-mobile.svg";
import Button from "./Button.astro";

interface NavbarProps {
  variant: "default" | "transparent";
  languages: string;
  user?: boolean;
  showLogoInNav?: boolean;
  // Desktop-only "peekaboo" mode: header stays hidden above an invisible
  // fixed strip until hovered/focused, then slides down. Opt-in per usage
  // site (e.g. visual story), independent from `variant` (bg/positioning).
  hoverReveal?: boolean;
}

const {
  variant,
  languages,
  user = true,
  showLogoInNav = true,
  hoverReveal = false,
} = Astro.props as NavbarProps;

const isDefaultVariant = variant === "default";

const navbarClasses = isDefaultVariant ? "bg-base-200" : "bg-transparent";

const wrapperPositionClasses = hoverReveal
  ? "sticky top-0 z-20 lg:fixed lg:inset-x-0 lg:top-0 lg:z-30"
  : isDefaultVariant
    ? "sticky top-0 z-20"
    : "absolute";

const headerRevealClasses = hoverReveal
  ? "lg:-translate-y-full lg:group-hover/navreveal:translate-y-0 lg:group-focus-within/navreveal:translate-y-0"
  : "";

const colorClasses = "text-base-content";
const borderClasses = "border-none";
const headerScrollClasses = isDefaultVariant
  ? "$store.navbar.isScrolled ? 'shadow-[0_10px_30px_rgba(0,0,0,0.08)]' : 'shadow-none'"
  : "";

const logoSrc = logo.src;
const currentPath = Astro.url.pathname;
---

<div
  class:list={[
    "group/navreveal w-full h-[80px] lg:h-[90px]",
    wrapperPositionClasses,
  ]}
>
  <header
    x-data="{}"
    x-bind:class={headerScrollClasses}
    class:list={[
      "w-full h-full transition-[transform,box-shadow] duration-300 ease-out",
      headerRevealClasses,
    ]}
  >
    <!-- Background Layer -->
    <div class:list={["absolute inset-0 w-full h-full z-0", navbarClasses]}>
    </div>

    <!-- Content Layer -->
    <nav
      class:list={[
        "relative z-10 w-full h-full px-4 lg:px-[57px] flex items-center justify-between",
        colorClasses,
        borderClasses,
      ]}
    >
      <!-- Left Side Group (Logo + Menu) -->
      <div class="flex items-center relative">
        {
          showLogoInNav && (
            <a
              class="cursor-pointer transition-transform duration-200 ease-out hover:scale-105 inline-block"
              href="/"
            >
              <img src={logo.src} alt="MAAG France" class="w-12 lg:w-16" />
            </a>
          )
        }
        <!-- Desktop Menu -->
        <div
          class="hidden lg:flex absolute top-1/2 left-full -translate-y-1/2 ml-12"
        >
          <ul class="flex items-center text-base-content whitespace-nowrap">
            <li
              class:list={[
                "relative pb-0.5 font-navbar uppercase text-[18px] tracking-[4px] font-normal",
                "after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-px after:bg-current after:origin-center after:transition-transform after:duration-[250ms] after:ease-in-out",
                "hover:after:scale-x-100",
                currentPath.startsWith("/culture")
                  ? "after:scale-x-100"
                  : "after:scale-x-0",
              ]}
            >
              <a href="/culture">Культура</a>
            </li>
            <div class="w-[1px] h-[18px] bg-neutral-200 mx-6"></div>
            <li
              class:list={[
                "relative pb-0.5 font-navbar uppercase text-[18px] tracking-[4px] font-normal",
                "after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-px after:bg-current after:origin-center after:transition-transform after:duration-[250ms] after:ease-in-out",
                "hover:after:scale-x-100",
                currentPath.startsWith("/paris")
                  ? "after:scale-x-100"
                  : "after:scale-x-0",
              ]}
            >
              <a href="/paris">Париж</a>
            </li>
            <div class="w-[1px] h-[18px] bg-neutral-200 mx-6"></div>
            <li
              class:list={[
                "relative pb-0.5 font-navbar uppercase text-[18px] tracking-[4px] font-normal",
                "after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-px after:bg-current after:origin-center after:transition-transform after:duration-[250ms] after:ease-in-out",
                "hover:after:scale-x-100",
                currentPath.startsWith("/calendar")
                  ? "after:scale-x-100"
                  : "after:scale-x-0",
              ]}
            >
              <a href="/calendar">Календарь</a>
            </li>
            <!-- <div class="w-[1px] h-[12px] bg-neutral-300 mx-6"></div>
            <li
              class="nav-item font-oswald uppercase tracking-[.46em] text-base font-normal hover:border-b hover:border-base-content pb-0.5"
            >
              <a href="/about" class="">О проекте</a>
            </li> -->
          </ul>
        </div>
      </div>

      <!-- Mobile Controls -->
      <div x-data="{}" class="flex items-center gap-4 lg:hidden">
        <button type="button" class="p-2">
          <Search />
        </button>
        <button
          type="button"
          class="p-2"
          @click="$store.navbar.toggle()"
          aria-controls="mobile-menu"
          x-bind:aria-expanded="$store.navbar.isOpen"
        >
          <img src={burgerIcon.src} alt="Открыть меню" class="h-5 w-5" />
        </button>
      </div>

      <!-- Right Side -->
      <div class="hidden lg:flex items-center gap-[19px]">
        <!-- TODO remove 'hidden' -->
        <button class="p-2 hidden">
          <Search />
        </button>
        <a
          href="https://www.instagram.com/stories/maag_france/"
          target="_blank"
          class="hover:text-gray-500 transition-colors"
          aria-label="Instagram"
        >
          <InstagramLogo class="w-10 h-10 lg:w-8 lg:h-8" />
        </a>
        <div class="flex items-center gap-4" x-data="$lazy('navbar')">
          <!-- Loading State -->
          <template x-if="$store.auth.isLoading">
            <button class="btn btn-outline btn-primary" disabled>...</button>
          </template>
          <!-- Logged Out State -->
          <template x-if="!$store.auth.isLoading && !$store.auth.isLoggedIn">
            <button
              @click.prevent="$store.auth.openAuthModal()"
              class="inline-flex h-11 items-center gap-2 rounded-lg border border-base-300 px-4 font-inter text-sm text-base-content transition hover:border-base-content/30 hover:bg-maag-beige disabled:cursor-wait disabled:opacity-60 cursor-pointer"
            >
              Войти
            </button>
          </template>
          <!-- Logged In State -->
          <template x-if="!$store.auth.isLoading && $store.auth.isLoggedIn">
            <div class="flex items-center gap-4">
              <a
                href="/profile"
                class="flex items-center justify-center w-10 h-10 text-primary-content rounded-full font-bold text-lg hover:drop-shadow-lg transition-shadow"
                :class="$store.auth.profile?.role === 'admin' ? 'bg-error/50' : 'bg-primary'"
              >
                <div
                  x-text="($store.auth.profile?.firstName?.[0] || '') + ($store.auth.profile?.lastName?.[0] || '')"
                >
                </div>
              </a>
              <button
                @click.prevent="handleSignOut()"
                class="inline-flex h-11 items-center gap-2 rounded-lg border border-base-300 px-4 font-inter text-sm text-base-content transition hover:border-base-content/30 hover:bg-maag-beige disabled:cursor-wait disabled:opacity-60 cursor-pointer"
              >
                Выйти
              </button>
            </div>
          </template>
        </div>
      </div>
    </nav>
  </header>
</div>
