---
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<div
  class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex h-28 items-end justify-end bg-gradient-to-t from-black/80 to-transparent p-4 opacity-0 transition-opacity duration-200 sm:h-36 sm:group-hover:opacity-100"
  x-bind:class="open && 'opacity-100'"
>
  <p class="max-w-[85%] text-right text-[11px] leading-snug text-white sm:text-xs">
    {caption}
  </p>
</div>
