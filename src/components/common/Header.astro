---
import Navbar from "./Navbar.astro";
import type { Locale } from "@/lib/i18n/locales";

interface HeaderProps {
  variant?: "default" | "transparent";
  hoverReveal?: boolean;
  locale?: Locale;
  languageSwitch?: { locale: Locale; links: Record<Locale, string> } | null;
}
const { variant, hoverReveal, locale, languageSwitch } = Astro.props as HeaderProps;

---

<Navbar
  variant={variant}
  hoverReveal={hoverReveal}
  locale={locale}
  languageSwitch={languageSwitch}
/>
