---
// Variant A — Magazine Cover: portrait image, gradient overlay, title on photo
import picture3 from "../../assets/images/article_content/par.jpeg";
import LazyImage from "./LazyImage.astro";

interface NetlenkaCardOneProps {
  title?: string;
  category?: string;
  categoryHref?: string | null;
  date?: string;
  hideDate?: boolean;
  lead?: string;
  transitionName?: string;
  imageUrl?: string;
  href?: string;
}

const {
  title = "Без названия",
  category = "Самое Читаемое",
  categoryHref = null,
  lead = "",
  transitionName,
  imageUrl,
  href = "#",
} = Astro.props as NetlenkaCardOneProps;

const imageLoading: "lazy" | "eager" = imageUrl ? "lazy" : "eager";
---

<div class="w-full">
  <div class="linked-image-hover relative block aspect-[2/3] overflow-hidden">
    <LazyImage
      src={imageUrl || picture3}
      alt={imageUrl ? title : "Editorial image"}
      class="linked-image-hover__media w-full h-full object-cover object-center"
      loading={imageLoading}
      transitionName={transitionName}
    />

    <div
      class="absolute bottom-0 left-0 right-0 h-1/2 bg-gradient-to-t from-black/90 to-transparent"
    >
    </div>

    {
      category &&
        (categoryHref ? (
          <a
            href={categoryHref}
            class="absolute top-0 left-0 z-[2] text-xs font-semibold uppercase tracking-[0.25em] text-white bg-accent px-2 py-1 font-['Inter'] hover:underline"
          >
            {category}
          </a>
        ) : (
          <span class="absolute top-3 left-3 z-[2] text-xs font-semibold uppercase tracking-[0.25em] text-white bg-accent px-2 py-1 font-['Inter']">
            {category}
          </span>
        ))
    }

    <div class="absolute bottom-0 left-0 right-0 p-4 pb-5">
      <h3
        class="m-0 text-white text-[28px] font-light font-old_standard tracking-[-0.02em] leading-[1.2]"
      >
        {title}
      </h3>
      <!-- {
        lead && (
          <p class="mt-2 m-0 text-[15px] text-white/65 font-inter font-normal line-clamp-2">
            {lead}
          </p>
        )
      } -->
    </div>

    <a href={href} class="absolute inset-0 z-[1]" aria-label={title}></a>
  </div>
</div>
