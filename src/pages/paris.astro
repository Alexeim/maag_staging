---
import Layout from "../Layouts/Layout.astro";
import { getTransitionName } from "../lib/utils/transitions";
import NetlenkaCardOne from "@/components/common/NetlenkaCardOne.astro";
import LatestInterview from "@/components/HomePage/LatestInterview.astro";
import MaagLogoPaid from "../assets/logo/maaglogo.svg";
import { isLegacyParisTag } from "@/content/tags/tags";
import {
  getPrimaryBadgeHref,
  getPrimaryBadgeLabel,
} from "@/lib/utils/contentBadge";
import picture1 from "../assets/images/culture.jpg";
import { publicParisApi } from "@/lib/api/api";
import parisTagsData from "@/content/tags/ParisTags.json";
import { Eye, Footprints, Bookmark, BookOpen } from "@lucide/astro";

const MAX_EDITORIAL_GRID_ITEMS = 12;

// Quick nav under the page title — pulled straight from ParisTags.json so the
// links always point at tags that actually exist in the system.
const PARIS_TOP_NAV_TAGS = parisTagsData.parisSubCategories;

// Mock data for the 4 quick-filter dropdowns under the page title.
// TODO: replace with real filter options once the backend exposes them.
const PARIS_MOCK_DROPDOWNS = [
  {
    label: "Узнать",
    icon: Eye,
    items: [
      "История",
      "Архитектура",
      "Культура",
      "Кулинария",
      "Знакомства",
      "Смотреть все",
    ],
  },
  {
    label: "Идти",
    icon: Footprints,
    items: ["Рестораны", "Музеи", "Прогулки", "Мероприятия"],
  },
  {
    label: "Сохранить",
    icon: Bookmark,
    items: ["Избранное", "Подборки", "Черновики"],
  },
  {
    label: "Почитать",
    icon: BookOpen,
    items: ["Гиды", "Интервью", "Новости"],
  },
];

const getDate = (timestamp: any): Date => {
  if (timestamp instanceof Date) {
    return timestamp;
  }
  if (timestamp && typeof timestamp === "object" && "_seconds" in timestamp) {
    return new Date((timestamp as { _seconds: number })._seconds * 1000);
  }
  return new Date(timestamp);
};

const formatDate = (value: unknown) => {
  const date = getDate(value);
  if (Number.isNaN(date.getTime())) {
    return "";
  }
  return date
    .toLocaleDateString("ru-RU", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
    .replace(" г.", "");
};

const normalizeTags = (value: unknown): string[] => {
  if (!Array.isArray(value)) {
    return [];
  }
  return value
    .map((tag) => (typeof tag === "string" ? tag.trim() : ""))
    .filter((tag) => Boolean(tag) && !isLegacyParisTag(tag));
};

// Paris-specific: strips legacy "Le Saviez-Vous" tag values before picking
// the primary badge, then defers to the shared news/interview/tag rules.
const getPrimaryTag = (item: any): string =>
  getPrimaryBadgeLabel({ ...item, tags: normalizeTags(item?.tags) });

const getPrimaryTagHref = (item: any): string | null =>
  getPrimaryBadgeHref({ ...item, tags: normalizeTags(item?.tags) });

const getCardLead = (item: any): string => {
  const cardLead =
    typeof item?.cardLead === "string" ? item.cardLead.trim() : "";
  return cardLead;
};

const truncateText = (text?: string, maxLength: number = 220) => {
  if (!text) return "";
  if (text.length <= maxLength) return text;
  const truncated = text.slice(0, maxLength).trim();
  const lastSpaceIndex = truncated.lastIndexOf(" ");
  const safeText =
    lastSpaceIndex > 0 ? truncated.slice(0, lastSpaceIndex) : truncated;
  return `${safeText.trim()}...`;
};

let primaryParisArticle: any = null;
let twoImageArticle: any = null;
let interviewFeature: any = null;
let secondaryStories: any[] = [];
let editorialSidebarItems: any[] = [];
let parisFeed: any[] = [];
let photoOfTheDay: any = null;

try {
  const parisPage = await publicParisApi.get();
  primaryParisArticle = parisPage.primaryParisArticle;
  twoImageArticle = parisPage.twoImageArticle;
  interviewFeature = parisPage.interviewFeature;
  secondaryStories = parisPage.secondaryStories as any[];
  editorialSidebarItems = parisPage.editorialSidebarItems as any[];
  parisFeed = parisPage.parisFeed as any[];
  photoOfTheDay = parisPage.photoOfTheDay;
} catch (error) {
  console.error("Failed to fetch paris page articles:", error);
}

const editorialGridItems = parisFeed.slice(0, MAX_EDITORIAL_GRID_ITEMS);
const editorialCarouselItems = parisFeed.slice(MAX_EDITORIAL_GRID_ITEMS);

const splitTitle = (t: string) => {
  const s = t.trimEnd();
  const i = s.lastIndexOf(" ");
  return {
    start: i >= 0 ? s.slice(0, i) : "",
    last: i >= 0 ? s.slice(i + 1) : s,
  };
};

const primaryParisTrunc = primaryParisArticle
  ? truncateText(primaryParisArticle.title, 96)
  : "";
const primaryParisSplit = splitTitle(primaryParisTrunc);

const twoImageArticleTrunc = twoImageArticle
  ? truncateText(twoImageArticle.title, 88)
  : "";
const twoImageArticleSplit = splitTitle(twoImageArticleTrunc);

// Mirrors culture.astro's featuredInterview handling: interviews store their
// headline quote in mainQuote (falling back to the first quote/qa content
// block for older records), and the interviewee's name in `interviewee`.
const extractInterviewQuote = (interview: any): string | null => {
  if (!interview) return null;
  if (interview.mainQuote) return interview.mainQuote;
  if (!Array.isArray(interview.content)) return interview.lead ?? null;
  const quoteBlock = interview.content.find(
    (block: any) => block.type === "quote" && block.text,
  );
  if (quoteBlock) return quoteBlock.text;
  const qaBlock = interview.content.find(
    (block: any) => block.type === "qa" && block.answer,
  );
  return qaBlock?.answer ?? interview.lead ?? null;
};

const interviewQuote = extractInterviewQuote(interviewFeature);
const interviewName =
  interviewFeature?.interviewee ?? interviewFeature?.title ?? "";
---

<Layout
  navbarVariant="default"
  includePreFooterCTA={false}
  title="Париж — гиды, места и жизнь в городе | MAAG France"
  description="Авторские материалы о Париже: районы, маршруты, места, события, городская жизнь и практические гиды для русскоязычных жителей и гостей Франции."
  useClientRouter={true}
>
  <main class="min-h-screen bg-base-200 text-black">
    <div
      class="mx-auto max-w-[1440px] px-4 pb-20 sm:px-6 lg:px-8 lg:pb-[6.5rem]"
    >
      <div class="pt-8 lg:pt-10">
        <h1
          class="m-0 text-3xl lg:text-[28px] font-old_standard font-base uppercase tracking-[0.46em] text-base-content"
        >
          Париж
        </h1>

        <!-- {
          PARIS_TOP_NAV_TAGS.length > 0 && (
            <nav class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2">
              {PARIS_TOP_NAV_TAGS.map((tag) => (
                <a
                  href={`/tag/${encodeURIComponent(tag)}`}
                  class="text-xs font-normal uppercase leading-none tracking-[0.25em] text-base-content/70 font-['Inter'] hover:text-accent hover:underline"
                >
                  {tag}
                </a>
              ))}
            </nav>
          )
        } -->

        <div class="mt-6 flex flex-wrap items-center gap-3 ml-20">
          {
            PARIS_MOCK_DROPDOWNS.map((dropdown) => {
              const Icon = dropdown.icon;
              return (
                <details name="paris-quick-filters" class="group relative">
                  <summary class="flex cursor-pointer list-none items-center gap-2 border border-primary p-4 text-xs font-semibold uppercase tracking-[0.2em] font-['Inter'] text-base-content transition-colors hover:border-base-content [&::-webkit-details-marker]:hidden">
                    <Icon class="h-4 w-4" />
                    {dropdown.label}
                    <span class="text-[10px] transition-transform duration-200 group-open:rotate-180">
                      ▾
                    </span>
                  </summary>
                  <ul class="absolute left-0 z-30 mt-2 min-w-[200px] border border-base-content/15 bg-base-200 py-2 shadow-lg">
                    {dropdown.items.map((item) => (
                      <li>
                        <a
                          href="#"
                          class="block px-4 py-1.5 text-xs uppercase tracking-[0.15em] font-['Inter'] text-base-content/80 hover:bg-base-content/5 hover:text-accent"
                        >
                          {item}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })
          }
        </div>
      </div>

      <div class="mt-8 overflow-visible lg:h-[calc(100svh-90px)]">
        {
          primaryParisArticle ? (
            <article class="flex flex-col gap-6 lg:h-full">
              <div class="lg:flex-none">
                <div class="inline-flex w-fit flex-col items-center gap-3">
                  <p class="m-0">
                    {getPrimaryTagHref(primaryParisArticle) ? (
                      <a
                        href={getPrimaryTagHref(primaryParisArticle)}
                        class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter'] hover:underline"
                      >
                        {getPrimaryTag(primaryParisArticle)}
                      </a>
                    ) : (
                      <span class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter']">
                        {getPrimaryTag(primaryParisArticle)}
                      </span>
                    )}
                  </p>

                  <a
                    href={primaryParisArticle.href}
                    class="text-left text-current no-underline hover:underline"
                  >
                    <h2 class="text-3xl lg:text-[44px] font-normal font-old_standard tracking-[-0.02em] transition-opacity duration-200 hover:opacity-90">
                      {primaryParisArticle.paid ? (
                        <>
                          {primaryParisSplit.start && (
                            <>{primaryParisSplit.start} </>
                          )}
                          <span class="whitespace-nowrap">
                            {primaryParisSplit.last}{" "}
                            <MaagLogoPaid class="w-4 h-4 inline-block align-baseline" />
                          </span>
                        </>
                      ) : (
                        primaryParisTrunc
                      )}
                    </h2>
                  </a>
                </div>
              </div>

              <div class="grid gap-6 lg:min-h-0 lg:flex-1 lg:grid-cols-[minmax(0,0.8fr)_minmax(18rem,1fr)] lg:grid-rows-1 lg:items-stretch">
                <div class="grid content-start gap-10 lg:h-full lg:min-h-0 lg:content-center">
                  {getCardLead(primaryParisArticle) && (
                    <p class="text-[30px] text-base-content/70 font-old_standard font-light">
                      {truncateText(getCardLead(primaryParisArticle), 280)}
                    </p>
                  )}

                  <a
                    href={primaryParisArticle.href}
                    class="inline-flex w-fit items-center border border-base-content px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.2em] font-['Inter'] text-base-content no-underline transition-colors hover:bg-base-content hover:text-base-200"
                  >
                    Читать дальше
                  </a>

                  <p class="hidden font-inter text-[0.68rem] uppercase tracking-[0.18em] text-base-content/40">
                    {formatDate(primaryParisArticle.publishedAt)}
                  </p>
                </div>

                <a
                  href={primaryParisArticle.href}
                  class="linked-image-hover block aspect-[4/5] overflow-hidden lg:aspect-auto lg:h-full lg:min-h-0"
                  aria-label={primaryParisArticle.title}
                >
                  <img
                    src={primaryParisArticle.imageUrl || picture1.src}
                    alt={primaryParisArticle.title}
                    class="linked-image-hover__media block h-full w-full object-cover"
                    loading="lazy"
                  />
                </a>
              </div>
            </article>
          ) : (
            <article class="border border-base-content/15 bg-white p-5 text-[1.05rem] font-light leading-[1.5]">
              Пока нет материалов категории «Париж».
            </article>
          )
        }
      </div>

      <div class="w-full my-8 lg:my-10">
        <hr class="h-px border-1" />
      </div>

      {
        editorialSidebarItems.length > 0 && (
          <section class="mb-10 lg:mb-14">
            <p class="m-0 mb-4 text-lg font-normal uppercase tracking-[0.3em] font-old_standard">
              записная книжка
            </p>

            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-6">
              {editorialSidebarItems.map((item) => (
                <NetlenkaCardOne
                  title={item.title}
                  category={getPrimaryTag(item)}
                  categoryHref={getPrimaryTagHref(item)}
                  imageUrl={item.imageUrl}
                  href={item.href}
                  transitionName={getTransitionName(item)}
                  hideDate={true}
                />
              ))}
            </div>
          </section>
        )
      }

      <div class="grid gap-2">
        {
          twoImageArticle && (
            <article class="grid gap-6 pb-8">
              <div class="inline-flex w-fit flex-col items-center gap-3">
                <p class="m-0">
                  {getPrimaryTagHref(twoImageArticle) ? (
                    <a
                      href={getPrimaryTagHref(twoImageArticle)}
                      class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter'] hover:underline"
                    >
                      {getPrimaryTag(twoImageArticle)}
                    </a>
                  ) : (
                    <span class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter']">
                      {getPrimaryTag(twoImageArticle)}
                    </span>
                  )}
                </p>

                <a
                  href={twoImageArticle.href}
                  class="text-left text-current no-underline hover:underline"
                >
                  <h3 class="text-3xl lg:text-[44px] font-normal font-old_standard tracking-[-0.02em] transition-opacity duration-200 hover:opacity-90">
                    {twoImageArticle.paid ? (
                      <>
                        {twoImageArticleSplit.start && (
                          <>{twoImageArticleSplit.start} </>
                        )}
                        <span class="whitespace-nowrap">
                          {twoImageArticleSplit.last}{" "}
                          <MaagLogoPaid class="w-4 h-4 inline-block align-baseline" />
                        </span>
                      </>
                    ) : (
                      twoImageArticleTrunc
                    )}
                  </h3>
                </a>
              </div>
              <div />
              <div class="w-full flex flex-col lg:flex-row">
                <div class="w-1/2">
                  <div class="h-[700px] relative">
                    <a
                      href={twoImageArticle.href}
                      class="linked-image-hover aspect-[2/3] h-[460px] overflow-hidden absolute left-1/2 translate-x-[calc(-50%-120px)] -rotate-6 border-[10px] border-white"
                      aria-label={twoImageArticle.title}
                    >
                      <img
                        src={twoImageArticle.imageUrl || picture1.src}
                        alt={twoImageArticle.title}
                        class="linked-image-hover__media block h-full w-full object-cover"
                        loading="lazy"
                      />
                    </a>
                    <a
                      href={twoImageArticle.href}
                      class="aspect-[2/3] h-[460px] overflow-hidden linked-image-hover absolute bottom-0 left-1/2 translate-x-[calc(-50%+120px)] rotate-12 border-[10px] border-white"
                      aria-label={twoImageArticle.title}
                    >
                      <img
                        src={picture1.src}
                        alt=""
                        class="linked-image-hover__media block h-full w-full object-cover"
                        loading="lazy"
                      />
                    </a>
                  </div>
                </div>
                <div class="w-1/2">
                  <div>
                    {getCardLead(twoImageArticle) && (
                      <p class="text-base text-base-content/70 font-inter font-light">
                        {truncateText(getCardLead(twoImageArticle), 220)}
                      </p>
                    )}

                    <a
                      href={twoImageArticle.href}
                      class="inline-flex w-fit items-center border border-base-content px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.2em] font-['Inter'] text-base-content no-underline transition-colors hover:bg-base-content hover:text-base-200"
                    >
                      Читать дальше
                    </a>
                  </div>
                </div>
              </div>

              <div class="w-full mb-8">
                <hr class="h-px border-1" />
              </div>
            </article>
          )
        }

        {
          interviewFeature && (
            <LatestInterview
              tag="Интервью"
              interviewee={interviewName}
              quote={
                interviewQuote ? truncateText(interviewQuote, 130) : undefined
              }
              imageUrl={interviewFeature.imageUrl || picture1.src}
              href={`/interviews/${interviewFeature.id}`}
              transitionName={getTransitionName({
                id: interviewFeature.id,
                href: `/interviews/${interviewFeature.id}`,
              })}
              inversed
            />
          )
        }

        {
          secondaryStories.length > 0 && (
            <div class="grid gap-x-4 gap-y-8 sm:grid-cols-2 sm:items-stretch mt-4 mb-6">
              {secondaryStories.map((item) => (
                <article class="grid h-full grid-rows-[auto_1fr] gap-[0.8rem]">
                  <a
                    href={item.href}
                    class="linked-image-hover aspect-[3/2]"
                    aria-label={item.title}
                  >
                    <img
                      src={item.imageUrl || picture1.src}
                      alt={item.title}
                      class="linked-image-hover__media block h-full w-full object-cover"
                      loading="lazy"
                    />
                  </a>

                  <div class="grid h-full content-start gap-[0.55rem]">
                    <p class="m-0">
                      {getPrimaryTagHref(item) ? (
                        <a
                          href={getPrimaryTagHref(item)}
                          class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter'] hover:underline"
                        >
                          {getPrimaryTag(item)}
                        </a>
                      ) : (
                        <span class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter']">
                          {getPrimaryTag(item)}
                        </span>
                      )}
                    </p>

                    <a
                      href={item.href}
                      class="block text-current no-underline hover:underline"
                    >
                      <h3 class="m-0 line-clamp-3 text-[1.4rem] font-normal font-old_standard tracking-[-0.02em] leading-[1.12]">
                        {(() => {
                          const t = truncateText(item.title, 88);
                          const { start, last } = splitTitle(t);
                          return item.paid ? (
                            <>
                              {start && <>{start} </>}
                              <span class="whitespace-nowrap">
                                {last}{" "}
                                <MaagLogoPaid class="w-4 h-4 inline-block align-baseline" />
                              </span>
                            </>
                          ) : (
                            t
                          );
                        })()}
                      </h3>
                    </a>

                    <p class="hidden m-0 text-xs font-inter uppercase tracking-[0.22em] text-base-content/55">
                      {formatDate(item.publishedAt)}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          )
        }

        {
          photoOfTheDay && (
            <article class="grid overflow-hidden bg-white lg:grid-cols-[12rem_minmax(0,1fr)]">
              <div class="grid content-center gap-3 p-6">
                <p class="m-0 text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter']">
                  Фото дня
                </p>
                <a
                  href={`/photo-of-the-day/${photoOfTheDay.id}`}
                  class="text-current no-underline hover:underline"
                >
                  <h3 class="m-0 text-2xl font-normal font-old_standard tracking-[-0.02em] leading-[1.2]">
                    {photoOfTheDay.title}
                  </h3>
                </a>
              </div>

              <a
                href={`/photo-of-the-day/${photoOfTheDay.id}`}
                class="linked-image-hover block aspect-[3/2] overflow-hidden"
                aria-label={photoOfTheDay.title}
              >
                <img
                  src={photoOfTheDay.imageUrl}
                  alt={photoOfTheDay.title}
                  class="linked-image-hover__media block h-full w-full object-cover"
                  loading="lazy"
                />
              </a>
            </article>
          )
        }
      </div>
      <div class="w-full my-8">
        <hr class="h-px border-1" />
      </div>
      <section class="mt-[2.2rem] pt-[1.6rem]">
        <div>
          {
            editorialGridItems.length > 0 ? (
              <>
                <div class="grid grid-cols-2 gap-x-4 gap-y-[1.4rem] lg:grid-cols-4 lg:gap-x-5 lg:gap-y-[1.9rem]">
                  {editorialGridItems.map((item) => (
                    <article class="grid h-full min-w-0 grid-rows-[auto_1fr] gap-[0.8rem]">
                      <a
                        href={item.href}
                        class="linked-image-hover bg-white aspect-[1.02/1]"
                        aria-label={item.title}
                      >
                        <img
                          src={item.imageUrl || picture1.src}
                          alt={item.title}
                          class="linked-image-hover__media block h-full w-full object-cover"
                          loading="lazy"
                        />
                      </a>

                      <div class="grid h-full content-start gap-[0.55rem]">
                        <p class="m-0">
                          {getPrimaryTagHref(item) ? (
                            <a
                              href={getPrimaryTagHref(item)}
                              class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter'] hover:underline"
                            >
                              {getPrimaryTag(item)}
                            </a>
                          ) : (
                            <span class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter']">
                              {getPrimaryTag(item)}
                            </span>
                          )}
                        </p>

                        <a
                          href={item.href}
                          class="block text-current no-underline hover:underline"
                        >
                          <h3 class="line-clamp-2 text-xl lg:text-2xl font-normal font-old_standard tracking-[-0.02em] transition-opacity duration-200 hover:opacity-90">
                            {(() => {
                              const t = truncateText(item.title, 72);
                              const { start, last } = splitTitle(t);
                              return item.paid ? (
                                <>
                                  {start && <>{start} </>}
                                  <span class="inline-block max-w-full overflow-hidden text-ellipsis whitespace-nowrap align-bottom">
                                    {last}{" "}
                                    <MaagLogoPaid class="w-4 h-4 inline-block align-baseline" />
                                  </span>
                                </>
                              ) : (
                                t
                              );
                            })()}
                          </h3>
                        </a>

                        <p class="hidden m-0 text-xs font-inter uppercase tracking-[0.22em] text-base-content/55">
                          {formatDate(item.publishedAt)}
                        </p>
                      </div>
                    </article>
                  ))}
                </div>

                {editorialCarouselItems.length > 0 && (
                  <div class="mt-[2rem] overflow-hidden">
                    <div
                      class="rubric-marquee-track flex items-start gap-6 py-2"
                      style="width: max-content;"
                    >
                      {[
                        ...editorialCarouselItems,
                        ...editorialCarouselItems,
                      ].map((item, i) => (
                        <div class="w-[240px] sm:w-[260px] lg:w-[280px] flex-shrink-0">
                          <article class="grid h-full grid-rows-[auto_1fr] gap-[0.8rem]">
                            <a
                              href={item.href}
                              class="linked-image-hover bg-white aspect-[1.02/1]"
                              aria-label={item.title}
                            >
                              <img
                                src={item.imageUrl || picture1.src}
                                alt={item.title}
                                class="linked-image-hover__media block h-full w-full object-cover"
                                loading="lazy"
                              />
                            </a>

                            <div class="grid h-full content-start gap-[0.55rem]">
                              <p class="m-0">
                                {getPrimaryTagHref(item) ? (
                                  <a
                                    href={getPrimaryTagHref(item)}
                                    class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter'] hover:underline"
                                  >
                                    {getPrimaryTag(item)}
                                  </a>
                                ) : (
                                  <span class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter']">
                                    {getPrimaryTag(item)}
                                  </span>
                                )}
                              </p>

                              <a
                                href={item.href}
                                class="block text-current no-underline hover:underline"
                              >
                                <h3 class="text-2xl font-normal font-old_standard tracking-[-0.02em] transition-opacity duration-200 hover:opacity-90">
                                  {truncateText(item.title, 72)}{" "}
                                  {item.paid && (
                                    <MaagLogoPaid class="w-4 h-4 inline-block align-baseline" />
                                  )}
                                </h3>
                              </a>

                              <p class="hidden m-0 text-xs font-inter uppercase tracking-[0.22em] text-base-content/55">
                                {formatDate(item.publishedAt)}
                              </p>
                            </div>
                          </article>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </>
            ) : (
              <article class="bg-white p-5 text-[1.05rem] font-light leading-[1.5]">
                Больше материалов пока нет.
              </article>
            )
          }
        </div>
      </section>
    </div>
  </main>
</Layout>

