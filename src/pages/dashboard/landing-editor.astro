            class="w-full rounded-lg border border-base-300 bg-base-100 px-3 py-2.5 text-sm text-base-content focus:outline-none focus:border-neutral-400 focus:ring-1 focus:ring-neutral-400/50 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <option value="1">1</option>
            <option value="2">2</option>
          </select>
        </div>

        <div x-show="parisCardsMode === 'manual'" class="grid gap-3">
          <p class="text-sm font-medium">
            Выбери карточки вручную. Порядок выбора сохранится в block.
          </p>

          {parisCardsOptions.length > 0 ? (
            <div class="grid gap-2 max-h-80 overflow-y-auto pr-1">
              {
                parisCardsOptions.map((item) => {
                  // coloured type badge from the shared MATERIAL_TYPES table
                  const badge = typeBadge(item.type);
                  return (
                    <label class="flex items-start gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
                      <input
                        type="checkbox"
                        class="mt-1"
                        :checked={`isManualParisCardSelected(${JSON.stringify(item.id)})`}
                        @change={`toggleParisCardItem(${JSON.stringify(item.id)})`}
                      />
                      <span class="flex flex-col items-start gap-1.5 leading-6">
                        {badge && (
                          <span
                            class:list={[
                              "shrink-0 rounded px-1.5 py-0.5 text-[11px] font-semibold leading-none",
                              badge.class,
                            ]}
                          >
                            {badge.text}
                          </span>
                        )}
                        <span class="font-old_standard text-base font-semibold">{item.title}</span>
                      </span>
                    </label>
                  );
                })
              }
            </div>
          ) : (
            <p class="text-sm text-base-content/70">
              Пока нет материалов для ручного выбора.
            </p>
          )}
        </div>

        <p x-show="parisCardsError" class="text-sm text-error" x-text="parisCardsError"></p>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="px-4 py-2 rounded-lg border text-sm transition cursor-pointer bg-primary text-primary-content border-primary disabled:opacity-50 disabled:cursor-not-allowed"
            @click="saveParisCards()"
            :disabled="parisCardsSaving"
          >
            Сохранить
          </button>
          <span x-show="parisCardsSaving" class="text-sm text-base-content/70">
            Сохраняем...
          </span>
        </div>
      </div>
    </div>
    <!-- Temporarily hidden: block is not used on the landing right now. -->
    <div class="hidden bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">А вы знали?</h3>
        <p class="text-sm text-base-content/70">
          Блок «А вы знали?» в секции «Париж» на лендинге.
        </p>
      </div>

      <div class="mt-5 grid gap-5">
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="le-saviez-vous-mode" value="empty" x-model="leSaviezVousMode" />
            <span class="text-sm">Empty</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="le-saviez-vous-mode" value="auto-latest" x-model="leSaviezVousMode" />
            <span class="text-sm">Auto latest</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="le-saviez-vous-mode" value="manual" x-model="leSaviezVousMode" />
            <span class="text-sm">Manual</span>
          </label>
        </div>

        <div x-show="leSaviezVousMode === 'manual'" class="grid gap-2 max-w-sm">
          <label for="le-saviez-vous-select" class="text-sm font-medium">Выбери материал</label>
          <CustomSelect
            id="le-saviez-vous-select"
            model="selectedLeSaviezVousId"
            itemsExpr={JSON.stringify(leSaviezVousOptions)}
            placeholder="— выбери материал —"
          />
        </div>

        <p x-show="leSaviezVousError" class="text-sm text-error" x-text="leSaviezVousError"></p>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="px-4 py-2 rounded-lg border text-sm transition cursor-pointer bg-primary text-primary-content border-primary disabled:opacity-50 disabled:cursor-not-allowed"
            @click="saveLeSaviezVous()"
            :disabled="leSaviezVousSaving"
          >
            Сохранить
          </button>
          <span x-show="leSaviezVousSaving" class="text-sm text-base-content/70">Сохраняем...</span>
        </div>
      </div>
    </div>

    <!-- Temporarily hidden: block is not used on the landing right now. -->
    <div class="hidden bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Фото дня</h3>
        <p class="text-sm text-base-content/70">
          Блок «Фото дня» в боковой колонке лендинга.
        </p>
      </div>

      <div class="mt-5 grid gap-5">
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="photo-of-the-day-mode" value="empty" x-model="photoOfTheDayMode" />
            <span class="text-sm">Empty</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="photo-of-the-day-mode" value="auto-latest" x-model="photoOfTheDayMode" />
            <span class="text-sm">Auto latest</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="photo-of-the-day-mode" value="manual" x-model="photoOfTheDayMode" />
            <span class="text-sm">Manual</span>
          </label>
        </div>

        <div x-show="photoOfTheDayMode === 'manual'" class="grid gap-2 max-w-sm">
          <label for="photo-of-the-day-select" class="text-sm font-medium">Выбери фото</label>
          <CustomSelect
            id="photo-of-the-day-select"
            model="selectedPhotoOfTheDayId"
            itemsExpr={JSON.stringify(photoOfTheDayOptions)}
            placeholder="— выбери фото —"
          />
        </div>

        <p x-show="photoOfTheDayError" class="text-sm text-error" x-text="photoOfTheDayError"></p>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="px-4 py-2 rounded-lg border text-sm transition cursor-pointer bg-primary text-primary-content border-primary disabled:opacity-50 disabled:cursor-not-allowed"
            @click="savePhotoOfTheDay()"
            :disabled="photoOfTheDaySaving"
          >
            Сохранить
          </button>
          <span x-show="photoOfTheDaySaving" class="text-sm text-base-content/70">Сохраняем...</span>
        </div>
      </div>
    </div>
  </section>
</DashboardLayout>
