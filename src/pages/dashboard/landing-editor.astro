---
import DashboardLayout from "@/Layouts/DashboardLayout.astro";
import CustomSelect from "@/components/dashboard/CustomSelect.astro";
import { PUBLIC_API_BASE_URL } from "@/lib/utils/constants";
// Shared type-badge metadata (label + colour classes), same source the /dashboard page uses.
import { MATERIAL_TYPES } from "@/lib/utils/dashboardMaterials";
import {
  articlesApi,
  editorialPlacementsApi,
  eventsApi,
  flippersApi,
  guidesApi,
  interviewsApi,
  newsApi,
  visualStoriesApi,
  photosOfTheDayApi,
  type LandingCategoryCardsItemType,
  type LandingMainHeroType,
  type LandingNetlenkaItemType,
  type LandingPlacementsResponse,
} from "@/lib/api/api";

// Culture/Paris sections always render 1 hero + exactly 2 cards below it
// (LandingBody.astro hard-caps with `.slice(0, 2)`), so the cards limit is 1–2.
const CATEGORY_CARDS_MAX_LIMIT = 2;
const clampCategoryCardsLimit = (value: unknown) => {
  const parsed = Number(value);
  if (!Number.isFinite(parsed)) {
    return CATEGORY_CARDS_MAX_LIMIT;
  }
  return Math.min(CATEGORY_CARDS_MAX_LIMIT, Math.max(1, Math.round(parsed)));
};

const DEFAULT_LANDING_PLACEMENTS: LandingPlacementsResponse = {
  schemaVersion: 4,
  mainHero: null,
  newsRail: {
    mode: "auto-latest",
    limit: 4,
  },
  netlenkaRail: {
    mode: "auto-latest",
    limit: 4,
  },
  cultureHero: null,
  cultureCards: {
    mode: "auto-latest",
    limit: CATEGORY_CARDS_MAX_LIMIT,
  },
  parisHero: null,
  parisCards: {
    mode: "auto-latest",
    limit: CATEGORY_CARDS_MAX_LIMIT,
  },
  eventCard: {
    mode: "auto-nearest",
  },
  cultureInterviewBlock: {
    mode: "auto-latest",
  },
  leSaviezVousFeature: {
    mode: "auto-latest",
  },
  photoOfTheDayFeature: {
    mode: "auto-latest",
  },
  updatedAt: null,
  updatedBy: null,
};

const MAIN_HERO_TYPE_LABELS: Record<LandingMainHeroType, string> = {
  article: "Статья",
  guide: "Путеводитель",
  interview: "Интервью",
  flipper: "Листалка",
  "visual-story": "Крупным планом",
};

const NETLENKA_TYPE_LABELS: Record<LandingNetlenkaItemType, string> = {
  ...MAIN_HERO_TYPE_LABELS,
};

const CATEGORY_CARDS_TYPE_LABELS: Record<LandingCategoryCardsItemType, string> = {
  article: MAIN_HERO_TYPE_LABELS.article,
  guide: MAIN_HERO_TYPE_LABELS.guide,
  flipper: MAIN_HERO_TYPE_LABELS.flipper,
  "visual-story": MAIN_HERO_TYPE_LABELS["visual-story"],
};

const ARTICLE_BUCKET_LABELS = {
  culture: "Culture",
  paris: "Paris",
  tips: "Tips",
} as const;

const normalizeArticleBucket = (item: { articleType?: string; category?: string }) => {
  if (item.articleType === "tips") {
    return "tips" as const;
  }

  const normalizedCategory = item.category?.trim().toLowerCase();
  if (normalizedCategory === "culture") {
    return "culture" as const;
  }
  if (normalizedCategory === "paris") {
    return "paris" as const;
  }

  return null;
};

const isLeSaviezVousArticle = (item: { articleType?: string }) =>
  item.articleType === "le_saviez_vous";

const isHotContentItem = (item: { isHotContent?: boolean }) =>
  Boolean(item.isHotContent);

const isMaagChoiceItem = (item: { isMaagChoice?: boolean }) =>
  Boolean(item.isMaagChoice);

const isLandingPrimaryEligible = (item: {
  isHotContent?: boolean;
  isMaagChoice?: boolean;
}) => !isMaagChoiceItem(item);

const normalizeCategoryKey = (value?: string) => value?.trim().toLowerCase() ?? "";

const toDate = (value: unknown): Date | null => {
  if (!value) {
    return null;
  }
  if (value instanceof Date) {
    return value;
  }
  if (typeof value === "string" || typeof value === "number") {
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? null : parsed;
  }
  if (typeof value === "object") {
    const seconds =
      (value as { seconds?: number }).seconds ??
      (value as { _seconds?: number })._seconds;
    const nanoseconds =
      (value as { nanoseconds?: number }).nanoseconds ??
      (value as { _nanoseconds?: number })._nanoseconds ??
      0;
    if (typeof seconds === "number") {
      return new Date(seconds * 1000 + nanoseconds / 1_000_000);
    }
    if (typeof (value as { toDate?: () => Date }).toDate === "function") {
      const parsed = (value as { toDate: () => Date }).toDate();
      return Number.isNaN(parsed.getTime()) ? null : parsed;
    }
  }
  return null;
};

const formatUpdatedAt = (value: unknown) => {
  const date = toDate(value);
  if (!date) {
    return "—";
  }

  return date.toLocaleString("ru-RU", {
    day: "2-digit",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
};

let landingPlacements = DEFAULT_LANDING_PLACEMENTS;
let loadError = "";
let leSaviezVousItems: Array<{ id: string; title: string; createdAt: unknown; publishedAt?: unknown }> = [];
let photoOfTheDayItems: Array<{ id: string; title: string; createdAtMs: number | null; publishedAtMs: number | null }> = [];

const toMs = (value: unknown) => toDate(value)?.getTime() ?? null;

const contentTitleMaps = {
  mainHero: new Map<string, string>(),
  news: new Map<string, string>(),
  netlenka: new Map<string, string>(),
  events: new Map<string, string>(),
  interviews: new Map<string, string>(),
};
const netlenkaOptionItems: Array<{
  id: string;
  title: string;
  type: LandingNetlenkaItemType;
  typeLabel: string;
  createdAt: unknown;
  createdAtMs: number | null;
  publishedAtMs: number | null;
}> = [];
const cultureCardsOptionItems: Array<{
  id: string;
  title: string;
  type: LandingCategoryCardsItemType;
  typeLabel: string;
  createdAt: unknown;
  createdAtMs: number | null;
  publishedAtMs: number | null;
}> = [];
const parisCardsOptionItems: Array<{
  id: string;
  title: string;
  type: LandingCategoryCardsItemType;
  typeLabel: string;
  createdAt: unknown;
  createdAtMs: number | null;
  publishedAtMs: number | null;
}> = [];
const cultureHeroOptionItems: Array<{
  id: string;
  title: string;
  type: LandingCategoryCardsItemType;
  typeLabel: string;
  createdAt: unknown;
  createdAtMs: number | null;
  publishedAtMs: number | null;
}> = [];
const parisHeroOptionItems: Array<{
  id: string;
  title: string;
  type: LandingCategoryCardsItemType;
  typeLabel: string;
  createdAt: unknown;
  createdAtMs: number | null;
  publishedAtMs: number | null;
}> = [];
const contentDatesMap = new Map<string, { createdAtMs: number | null; publishedAtMs: number | null }>();
const eventDatesMap = new Map<string, { createdAtMs: number | null; publishedAtMs: number | null }>();
const mainHeroArticleMeta = new Map<
  string,
  {
    articleBucket: keyof typeof ARTICLE_BUCKET_LABELS;
    articleBucketLabel: string;
  }
>();

try {
  const [
    placements,
    articles,
    guides,
    interviews,
    flippers,
    visualStories,
    newsItems,
    events,
  ] = await Promise.all([
    editorialPlacementsApi.getLanding().catch(() => DEFAULT_LANDING_PLACEMENTS),
    articlesApi.list(),
    guidesApi.list(),
    interviewsApi.list(),
    flippersApi.list(),
    visualStoriesApi.list(),
    newsApi.list(),
    eventsApi.list(),
  ]);

  landingPlacements = placements;
  const currentMainHeroKey = landingPlacements.mainHero
    ? `${landingPlacements.mainHero.type}:${landingPlacements.mainHero.id}`
    : null;

  articles.forEach((item) => {
    const key = `article:${item.id}`;
    const articleBucket = normalizeArticleBucket(item);
    if (isLandingPrimaryEligible(item)) {
      contentTitleMaps.mainHero.set(key, item.title);
      contentDatesMap.set(key, { createdAtMs: toMs(item.createdAt), publishedAtMs: toMs(item.publishedAt) });
    }
    if (isMaagChoiceItem(item)) {
      contentTitleMaps.netlenka.set(key, item.title);
      netlenkaOptionItems.push({
        id: key,
        title: item.title,
        type: "article",
        typeLabel: NETLENKA_TYPE_LABELS.article,
        createdAt: item.createdAt,
        createdAtMs: toMs(item.createdAt),
        publishedAtMs: toMs(item.publishedAt),
      });
    }
    if (articleBucket) {
      mainHeroArticleMeta.set(key, {
        articleBucket,
        articleBucketLabel: ARTICLE_BUCKET_LABELS[articleBucket],
      });
    }
  });
  guides.forEach((item) => {
    if (isLandingPrimaryEligible(item)) {
      contentTitleMaps.mainHero.set(`guide:${item.id}`, item.title);
      contentDatesMap.set(`guide:${item.id}`, { createdAtMs: toMs(item.createdAt), publishedAtMs: toMs(item.publishedAt) });
    }
    if (isMaagChoiceItem(item)) {
      contentTitleMaps.netlenka.set(`guide:${item.id}`, item.title);
      netlenkaOptionItems.push({
        id: `guide:${item.id}`,
        title: item.title,
        type: "guide",
        typeLabel: NETLENKA_TYPE_LABELS.guide,
        createdAt: item.createdAt,
        createdAtMs: toMs(item.createdAt),
        publishedAtMs: toMs(item.publishedAt),
      });
    }
  });
  interviews.forEach((item) => {
    if (isLandingPrimaryEligible(item)) {
      contentTitleMaps.mainHero.set(`interview:${item.id}`, item.title);
      contentDatesMap.set(`interview:${item.id}`, { createdAtMs: toMs(item.createdAt), publishedAtMs: toMs(item.publishedAt) });
    }
    if (isMaagChoiceItem(item)) {
      contentTitleMaps.netlenka.set(`interview:${item.id}`, item.title);
      netlenkaOptionItems.push({
        id: `interview:${item.id}`,
        title: item.title,
        type: "interview",
        typeLabel: NETLENKA_TYPE_LABELS.interview,
        createdAt: item.createdAt,
        createdAtMs: toMs(item.createdAt),
        publishedAtMs: toMs(item.publishedAt),
      });
    }
    if (isLandingPrimaryEligible(item)) {
      contentTitleMaps.interviews.set(item.id, item.title);
    }
  });
  flippers.forEach((item) => {
    if (isLandingPrimaryEligible(item)) {
      contentTitleMaps.mainHero.set(`flipper:${item.id}`, item.title);
      contentDatesMap.set(`flipper:${item.id}`, { createdAtMs: toMs(item.createdAt), publishedAtMs: toMs(item.publishedAt) });
    }
    if (isMaagChoiceItem(item)) {
      contentTitleMaps.netlenka.set(`flipper:${item.id}`, item.title);
      netlenkaOptionItems.push({
        id: `flipper:${item.id}`,
        title: item.title,
        type: "flipper",
        typeLabel: NETLENKA_TYPE_LABELS.flipper,
        createdAt: item.createdAt,
        createdAtMs: toMs(item.createdAt),
        publishedAtMs: toMs(item.publishedAt),
      });
    }
  });
  visualStories.forEach((item) => {
    if (isLandingPrimaryEligible(item)) {
      contentTitleMaps.mainHero.set(`visual-story:${item.id}`, item.title);
      contentDatesMap.set(`visual-story:${item.id}`, { createdAtMs: toMs(item.createdAt), publishedAtMs: toMs(item.publishedAt) });
    }
    if (isMaagChoiceItem(item)) {
      contentTitleMaps.netlenka.set(`visual-story:${item.id}`, item.title);
      netlenkaOptionItems.push({
        id: `visual-story:${item.id}`,
        title: item.title,
        type: "visual-story",
        typeLabel: NETLENKA_TYPE_LABELS["visual-story"],
        createdAtMs: toMs(item.createdAt),
        publishedAtMs: toMs(item.publishedAt),
        createdAt: item.createdAt,
      });
    }
  });
  newsItems.forEach((item) => {
    contentTitleMaps.news.set(item.id, item.title);
  });
  events.forEach((item) => {
    contentTitleMaps.events.set(item.id, item.title);
    eventDatesMap.set(item.id, { createdAtMs: toMs(item.createdAt), publishedAtMs: null });
  });

  leSaviezVousItems = articles
    .filter((item) => isLeSaviezVousArticle(item) && isLandingPrimaryEligible(item))
    .sort((a, b) => {
      const aTime = toDate(a.createdAt)?.getTime() ?? 0;
      const bTime = toDate(b.createdAt)?.getTime() ?? 0;
      return bTime - aTime;
    });

  const categoryCardsCandidates = [
    ...articles
      .filter((item) => !isLeSaviezVousArticle(item))
      .map((item) => ({
        id: `article:${item.id}`,
        title: item.title,
        type: "article" as const,
        typeLabel: CATEGORY_CARDS_TYPE_LABELS.article,
        createdAt: item.createdAt,
        createdAtMs: toMs(item.createdAt),
        publishedAtMs: toMs(item.publishedAt),
        category: normalizeCategoryKey(item.category),
        isHotContent: isHotContentItem(item),
        isMaagChoice: isMaagChoiceItem(item),
      })),
    ...guides.map((item) => ({
      id: `guide:${item.id}`,
      title: item.title,
      type: "guide" as const,
      typeLabel: CATEGORY_CARDS_TYPE_LABELS.guide,
      createdAt: item.createdAt,
      createdAtMs: toMs(item.createdAt),
      publishedAtMs: toMs(item.publishedAt),
      category: normalizeCategoryKey(item.category),
      isHotContent: isHotContentItem(item),
      isMaagChoice: isMaagChoiceItem(item),
    })),
    ...flippers.map((item) => ({
      id: `flipper:${item.id}`,
      title: item.title,
      type: "flipper" as const,
      typeLabel: CATEGORY_CARDS_TYPE_LABELS.flipper,
      createdAt: item.createdAt,
      createdAtMs: toMs(item.createdAt),
      publishedAtMs: toMs(item.publishedAt),
      category: normalizeCategoryKey(item.category),
      isHotContent: isHotContentItem(item),
      isMaagChoice: isMaagChoiceItem(item),
    })),
    ...visualStories.map((item) => ({
      id: `visual-story:${item.id}`,
      title: item.title,
      type: "visual-story" as const,
      typeLabel: CATEGORY_CARDS_TYPE_LABELS["visual-story"],
      createdAt: item.createdAt,
      createdAtMs: toMs(item.createdAt),
      publishedAtMs: toMs(item.publishedAt),
      category: normalizeCategoryKey(item.category),
      isHotContent: isHotContentItem(item),
      isMaagChoice: isMaagChoiceItem(item),
    })),
  ]
    .filter((item) => !item.isMaagChoice && item.id !== currentMainHeroKey)
    .sort((left, right) => {
      const leftDate = toDate(left.createdAt)?.getTime() ?? 0;
      const rightDate = toDate(right.createdAt)?.getTime() ?? 0;
      if (leftDate !== rightDate) {
        return rightDate - leftDate;
      }

      return left.title.localeCompare(right.title, "ru-RU");
    });

  const cultureCandidates = categoryCardsCandidates.filter(
    (item) => item.category === "culture",
  );
  cultureHeroOptionItems.push(...cultureCandidates);
  const cultureHeroKey = landingPlacements.cultureHero
    ? `${landingPlacements.cultureHero.type}:${landingPlacements.cultureHero.id}`
    : null;

  cultureCardsOptionItems.push(
    ...cultureCandidates.filter((item) => item.id !== cultureHeroKey),
  );

  const parisCandidates = categoryCardsCandidates.filter(
    (item) => item.category === "paris",
  );
  parisHeroOptionItems.push(...parisCandidates);
  const parisHeroKey = landingPlacements.parisHero
    ? `${landingPlacements.parisHero.type}:${landingPlacements.parisHero.id}`
    : null;

  parisCardsOptionItems.push(
    ...parisCandidates.filter((item) => item.id !== parisHeroKey),
  );
} catch (error) {
  console.error("Failed to load landing editor overview:", error);
  loadError =
    error instanceof Error
      ? error.message
      : "Не удалось загрузить editorial slots landing.";
}

try {
  const photos = await photosOfTheDayApi.list();
  photoOfTheDayItems = photos.map((p) => ({
    id: p.id,
    title: p.title,
    createdAtMs: toMs(p.createdAt),
    publishedAtMs: toMs(p.publishedAt),
  }));
} catch (e) {
  console.error("Failed to fetch photos of the day for landing editor:", e);
}

const getBadgeClass = (modeLabel: string): string => {
  if (modeLabel === "Пусто") {
    return "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium bg-neutral-100 text-neutral-400 border-neutral-200";
  }
  if (modeLabel === "Manual") {
    return "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium bg-blue-50 text-blue-500 border-blue-200";
  }
  if (modeLabel.startsWith("Auto")) {
    return "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium bg-emerald-50 text-emerald-600 border-emerald-200";
  }
  return "inline-flex items-center rounded-full border border-base-300 px-2.5 py-0.5 text-xs font-medium text-base-content/60";
};

// A type badge for a picked material: the short label plus its Tailwind colour classes,
// taken from the shared MATERIAL_TYPES table so it matches the /dashboard page.
type TypeBadge = { text: string; class: string };

// Resolve a landing material type ("article", "guide", "interview", ...) to its badge,
// or undefined if that type has no entry.
const typeBadge = (type: string): TypeBadge | undefined => {
  const meta = MATERIAL_TYPES[type as keyof typeof MATERIAL_TYPES];
  return meta ? { text: meta.badge, class: meta.badgeClass } : undefined;
};

// One picked material: an optional type badge and its real title, kept as SEPARATE
// fields so the markup can render the badge as a pill and style the title on its own.
// `badge` is omitted for slots that do not show a type (section heroes, event, interview, news).
type SlotPick = { badge?: TypeBadge; title: string };

// The summary shown on a slot card, structured at the source instead of pre-glued into a string:
//   { kind: "note",  text }   -> a plain description (auto / empty states) — no material title in it
//   { kind: "picks", picks }  -> one or more picked materials
type SlotSummary =
  | { kind: "note"; text: string }
  | { kind: "picks"; picks: SlotPick[] };

// Build a plain-description summary.
const note = (text: string): SlotSummary => ({ kind: "note", text });

// Build a summary with exactly one picked material.
const pick = (title: string, badge?: TypeBadge): SlotSummary => ({
  kind: "picks",
  picks: [{ badge, title }],
});

// Build a summary from a list of picks; fall back to a plain description when the list is empty.
const picks = (list: SlotPick[], emptyText: string): SlotSummary =>
  list.length > 0 ? { kind: "picks", picks: list } : note(emptyText);

const mainHeroSummary = (() => {
  // nothing chosen -> plain description
  if (!landingPlacements.mainHero) {
    return {
      modeLabel: "Пусто",
      details: note("Главный hero-slot сейчас пуст."),
    };
  }

  // resolve the chosen material's type + real title
  const { type, id } = landingPlacements.mainHero;
  const title = contentTitleMaps.mainHero.get(`${type}:${id}`) || "Материал не найден";

  // one pick: type badge and title stay in separate fields
  return {
    modeLabel: "Manual",
    details: pick(title, typeBadge(type)),
  };
})();

const newsRailSummary = (() => {
  // block turned off -> plain description
  if (!landingPlacements.newsRail) {
    return {
      modeLabel: "Пусто",
      details: note("Блок новостей сейчас пуст."),
    };
  }

  // auto mode -> plain description, no titles
  if (landingPlacements.newsRail.mode === "auto-latest") {
    return {
      modeLabel: "Auto latest",
      details: note(`Последние ${landingPlacements.newsRail.limit} новости.`),
    };
  }

  // manual mode -> list of picked news; each is a bare title (news has no type label)
  const list = landingPlacements.newsRail.ids.map((newsId) => ({
    title: contentTitleMaps.news.get(newsId) || `Новость ${newsId}`,
  }));

  return {
    modeLabel: "Manual",
    details: picks(list, "Список новостей пуст."),
  };
})();

const netlenkaRailSummary = (() => {
  // block turned off -> plain description
  if (!landingPlacements.netlenkaRail) {
    return {
      modeLabel: "Пусто",
      details: note("Блок «Выбор MAAG» сейчас пуст."),
    };
  }

  // auto mode -> plain description, no titles
  if (landingPlacements.netlenkaRail.mode === "auto-latest") {
    return {
      modeLabel: "Auto latest",
      details: note(
        `Последние ${landingPlacements.netlenkaRail.limit} материала(ов) из «Выбор MAAG».`,
      ),
    };
  }

  // manual mode -> list of picks; type badge and title kept apart
  const list = landingPlacements.netlenkaRail.items.map(({ type, id }) => ({
    badge: typeBadge(type),
    title:
      contentTitleMaps.netlenka.get(`${type}:${id}`) ||
      `${NETLENKA_TYPE_LABELS[type]} ${id}`,
  }));

  return {
    modeLabel: "Manual",
    details: picks(list, "Список материалов пуст."),
  };
})();

const cultureHeroSummary = (() => {
  // nothing chosen -> plain description
  if (!landingPlacements.cultureHero) {
    return {
      modeLabel: "Пусто",
      details: note("Culture hero slot пуст."),
    };
  }

  // one pick with the badge of its actual type (can be article / guide / flipper / visual-story)
  const key = `${landingPlacements.cultureHero.type}:${landingPlacements.cultureHero.id}`;
  return {
    modeLabel: "Manual",
    details: pick(
      contentTitleMaps.mainHero.get(key) ||
        `${CATEGORY_CARDS_TYPE_LABELS[landingPlacements.cultureHero.type]} ${landingPlacements.cultureHero.id}`,
      typeBadge(landingPlacements.cultureHero.type),
    ),
  };
})();

const cultureCardsSummary = (() => {
  // block turned off -> plain description
  if (!landingPlacements.cultureCards) {
    return {
      modeLabel: "Пусто",
      details: note("Карточки culture section на landing сейчас пусты."),
    };
  }

  // auto mode -> plain description, no titles
  if (landingPlacements.cultureCards.mode === "auto-latest") {
    return {
      modeLabel: "Auto latest",
      details: note(
        `Последние ${landingPlacements.cultureCards.limit} карточки в culture section, с исключением global main hero и hero рубрики.`,
      ),
    };
  }

  // manual mode -> list of picks; type badge and title kept apart
  const list = landingPlacements.cultureCards.items.map(({ type, id }) => ({
    badge: typeBadge(type),
    title:
      contentTitleMaps.mainHero.get(`${type}:${id}`) ||
      `${CATEGORY_CARDS_TYPE_LABELS[type]} ${id}`,
  }));

  return {
    modeLabel: "Manual",
    details: picks(list, "Список материалов пуст."),
  };
})();

const parisHeroSummary = (() => {
  // nothing chosen -> plain description
  if (!landingPlacements.parisHero) {
    return {
      modeLabel: "Пусто",
      details: note("Paris hero slot пуст."),
    };
  }

  // one pick with the badge of its actual type (can be article / guide / flipper / visual-story)
  const key = `${landingPlacements.parisHero.type}:${landingPlacements.parisHero.id}`;
  return {
    modeLabel: "Manual",
    details: pick(
      contentTitleMaps.mainHero.get(key) ||
        `${CATEGORY_CARDS_TYPE_LABELS[landingPlacements.parisHero.type]} ${landingPlacements.parisHero.id}`,
      typeBadge(landingPlacements.parisHero.type),
    ),
  };
})();

const parisCardsSummary = (() => {
  // block turned off -> plain description
  if (!landingPlacements.parisCards) {
    return {
      modeLabel: "Пусто",
      details: note("Карточки paris section на landing сейчас пусты."),
    };
  }

  // auto mode -> plain description, no titles
  if (landingPlacements.parisCards.mode === "auto-latest") {
    return {
      modeLabel: "Auto latest",
      details: note(
        `Последние ${landingPlacements.parisCards.limit} карточки в paris section, с исключением global main hero и hero рубрики.`,
      ),
    };
  }

  // manual mode -> list of picks; type badge and title kept apart
  const list = landingPlacements.parisCards.items.map(({ type, id }) => ({
    badge: typeBadge(type),
    title:
      contentTitleMaps.mainHero.get(`${type}:${id}`) ||
      `${CATEGORY_CARDS_TYPE_LABELS[type]} ${id}`,
  }));

  return {
    modeLabel: "Manual",
    details: picks(list, "Список материалов пуст."),
  };
})();

const eventCardSummary = (() => {
  // nothing chosen -> plain description
  if (!landingPlacements.eventCard) {
    return {
      modeLabel: "Пусто",
      details: note("Event card сейчас пустая."),
    };
  }

  // auto mode -> plain description, no title
  if (landingPlacements.eventCard.mode === "auto-nearest") {
    return {
      modeLabel: "Auto nearest",
      details: note(
        "Сначала single-day событие на сегодня по latest created, если его нет — последний созданный active range event, затем ближайшее upcoming событие.",
      ),
    };
  }

  // one pick, bare title (event card does not display a type label)
  return {
    modeLabel: "Manual",
    details: pick(
      contentTitleMaps.events.get(landingPlacements.eventCard.id) ||
        `Событие ${landingPlacements.eventCard.id}`,
    ),
  };
})();

const cultureInterviewSummary = (() => {
  // nothing chosen -> plain description
  if (!landingPlacements.cultureInterviewBlock) {
