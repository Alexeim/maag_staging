      // block turned off -> plain description
      if (!landingPlacements.leSaviezVousFeature) return note("Le saviez-vous slot пуст.");
      // auto mode -> plain description, no title
      if (landingPlacements.leSaviezVousFeature.mode === "auto-latest")
        return note("Автоматически показывается последний le saviez-vous материал.");
      // manual mode -> one pick, bare title
