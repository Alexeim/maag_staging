---
import DashboardLayout from "@/Layouts/DashboardLayout.astro";
import Button from "@/components/common/Button.astro";
import DashboardArticleBodyPreview from "@/components/dashboard/DashboardArticleBodyPreview.astro";
---

<DashboardLayout title="Предпросмотр материала «от первого лица»" active="create-first-person">
  <div
    id="preview-container"
    class="max-w-[1512px] mx-auto"
    x-data="$lazy('firstPersonCreator', { isPreview: true })"
  >
    <div class="bg-base-100 border border-base-300 rounded-xl shadow-sm">
      <div class="px-6 py-6 border-b border-base-300 flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold">Предпросмотр материала «от первого лица»</h1>
          <p class="text-sm text-base-content/70 mt-1">
            Используй кнопки внизу, чтобы вернуться к редактированию или сохранить материал.
          </p>
        </div>
        <div class="flex gap-2">
          <Button variant="secondary" @click="returnToEdit()">Вернуться к редактированию</Button>
          <Button variant="primary" @click="saveFirstPerson()">Сохранить материал</Button>
        </div>
      </div>

      <main class="bg-base-100">
        <div class="pt-16 pb-20 flex flex-col items-center gap-16">
          <div class="flex flex-col sm:flex-row gap-8 max-w-[825px] w-full px-6">
            <div class="shrink-0">
              <template x-if="previewAuthorDisplay.noBgAvatarUrl">
                <img
                  :src="previewAuthorDisplay.noBgAvatarUrl"
                  alt=""
                  class="w-29.75 h-auto aspect-239/278 object-contain"
                />
              </template>
              <template x-if="!previewAuthorDisplay.noBgAvatarUrl">
                <div class="w-29.75 aspect-239/278 bg-base-200 rounded flex items-center justify-center text-xs text-base-content/50 text-center p-2">
                  Нет портрета без фона
                </div>
              </template>
            </div>
            <div>
              <p
                class="text-xs font-bold uppercase tracking-[0.25em] text-accent font-['Inter'] mb-2"
              >
                От первого лица
              </p>
              <h1
                class="text-3xl lg:text-[44px] leading-tight font-old_standard text-base-content w-full"
                x-text="article.title">
              </h1>
              <p
                class="text-base lg:text-xl font-thin font-old_standard italic text-base-content mt-4"
                x-text="getPreviewAuthorName()"
              ></p>
            </div>
          </div>
        </div>

        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-14 pb-16">
          <DashboardArticleBodyPreview imageAltLabel="First-person material image" />
        </div>
      </main>
    </div>
  </div>
</DashboardLayout>
