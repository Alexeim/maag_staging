---
import DashboardLayout from "@/Layouts/DashboardLayout.astro";
import CustomSelect from "@/components/dashboard/CustomSelect.astro";
import {
  articlesApi,
  editorialPlacementsApi,
  flippersApi,
  guidesApi,
  interviewsApi,
  photosOfTheDayApi,
  visualStoriesApi,
  type ParisPagePlacementsResponse,
  type SectionPageHeroType,
} from "@/lib/api/api";

const CONTENT_TYPE_LABELS: Record<SectionPageHeroType, string> = {
  article: "Статья",
  guide: "Путеводитель",
  interview: "Интервью",
  flipper: "Листалка",
  "visual-story": "Крупным планом",
};

const DEFAULT_PLACEMENTS: ParisPagePlacementsResponse = {
  schemaVersion: 2,
  hero: null,
  twoImageArticle: null,
  interviewFeature: { mode: "auto-latest" },
  secondaryStories: { mode: "auto-latest", limit: 2 },
  photoOfTheDayFeature: { mode: "auto-latest" },
  sidebarRail: { mode: "auto-hot", limit: 4 },
  updatedAt: null,
  updatedBy: null,
};

const toDate = (value: unknown): Date | null => {
  if (!value) return null;
  if (value instanceof Date) return value;
  if (typeof value === "string" || typeof value === "number") {
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? null : parsed;
  }
  if (typeof value === "object") {
    const seconds =
      (value as { seconds?: number })?.seconds ??
      (value as { _seconds?: number })?._seconds;
    if (typeof seconds === "number") return new Date(seconds * 1000);
  }
  return null;
};

const formatUpdatedAt = (value: unknown) => {
  const date = toDate(value);
  if (!date) return "—";
  return date.toLocaleString("ru-RU", {
    day: "2-digit",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
};

const normalizeCategoryKey = (value?: string) => value?.trim().toLowerCase() ?? "";

let placements = DEFAULT_PLACEMENTS;
let loadError = "";

type MaterialOption = {
  id: string;
  title: string;
  type: string;
  typeLabel: string;
  createdAtMs: number | null;
  publishedAtMs: number | null;
};

const toMs = (value: unknown) => toDate(value)?.getTime() ?? null;

const heroOptions: MaterialOption[] = [];
const interviewOptions: Array<{ id: string; title: string; createdAtMs: number | null; publishedAtMs: number | null }> = [];
const photoOfTheDayOptions: Array<{ id: string; title: string; createdAtMs: number | null; publishedAtMs: number | null }> = [];
const sidebarOptions: MaterialOption[] = [];

try {
  const [parisPagePlacements, articles, guides, flippers, visualStories, interviews, photos] =
    await Promise.all([
      editorialPlacementsApi.getParisPage().catch(() => DEFAULT_PLACEMENTS),
      articlesApi.list(),
      guidesApi.list(),
      flippersApi.list(),
      visualStoriesApi.list(),
      interviewsApi.list(),
      photosOfTheDayApi.list(),
    ]);

  placements = parisPagePlacements;

  photos.forEach((p) => {
    photoOfTheDayOptions.push({ id: p.id, title: p.title, createdAtMs: toMs(p.createdAt), publishedAtMs: toMs(p.publishedAt) });
  });

  articles
    .filter(
      (a) =>
        normalizeCategoryKey(a.category) === "paris" &&
        a.articleType !== "le_saviez_vous" &&
        !a.isHotContent &&
        !a.isNotebookContent,
    )
    .forEach((a) => {
      heroOptions.push({ id: `article:${a.id}`, title: a.title, type: "article", typeLabel: CONTENT_TYPE_LABELS.article, createdAtMs: toMs(a.createdAt), publishedAtMs: toMs(a.publishedAt) });
    });

  articles
    .filter((a) => Boolean(a.isNotebookContent))
    .forEach((a) => {
      sidebarOptions.push({ id: `article:${a.id}`, title: a.title, type: "article", typeLabel: CONTENT_TYPE_LABELS.article, createdAtMs: toMs(a.createdAt), publishedAtMs: toMs(a.publishedAt) });
    });

  guides
    .filter(
      (g) =>
        normalizeCategoryKey(g.category) === "paris" &&
        !g.isHotContent &&
        !g.isNotebookContent,
    )
    .forEach((g) => {
      heroOptions.push({ id: `guide:${g.id}`, title: g.title, type: "guide", typeLabel: CONTENT_TYPE_LABELS.guide, createdAtMs: toMs(g.createdAt), publishedAtMs: toMs(g.publishedAt) });
    });
  guides
    .filter((g) => Boolean(g.isNotebookContent))
    .forEach((g) => {
      sidebarOptions.push({ id: `guide:${g.id}`, title: g.title, type: "guide", typeLabel: CONTENT_TYPE_LABELS.guide, createdAtMs: toMs(g.createdAt), publishedAtMs: toMs(g.publishedAt) });
    });

  flippers
    .filter(
      (f) =>
        normalizeCategoryKey(f.category) === "paris" &&
        !f.isHotContent &&
        !f.isNotebookContent,
    )
    .forEach((f) => {
      heroOptions.push({ id: `flipper:${f.id}`, title: f.title, type: "flipper", typeLabel: CONTENT_TYPE_LABELS.flipper, createdAtMs: toMs(f.createdAt), publishedAtMs: toMs(f.publishedAt) });
    });
  flippers
    .filter((f) => Boolean(f.isNotebookContent))
    .forEach((f) => {
      sidebarOptions.push({ id: `flipper:${f.id}`, title: f.title, type: "flipper", typeLabel: CONTENT_TYPE_LABELS.flipper, createdAtMs: toMs(f.createdAt), publishedAtMs: toMs(f.publishedAt) });
    });

  visualStories
    .filter(
      (s) =>
        normalizeCategoryKey(s.category) === "paris" &&
        !s.isHotContent &&
        !s.isNotebookContent,
    )
    .forEach((s) => {
      heroOptions.push({ id: `visual-story:${s.id}`, title: s.title, type: "visual-story", typeLabel: CONTENT_TYPE_LABELS["visual-story"], createdAtMs: toMs(s.createdAt), publishedAtMs: toMs(s.publishedAt) });
    });
  visualStories
    .filter((s) => Boolean(s.isNotebookContent))
    .forEach((s) => {
      sidebarOptions.push({ id: `visual-story:${s.id}`, title: s.title, type: "visual-story", typeLabel: CONTENT_TYPE_LABELS["visual-story"], createdAtMs: toMs(s.createdAt), publishedAtMs: toMs(s.publishedAt) });
    });

  interviews
    .filter((i) => Boolean(i.isNotebookContent))
    .forEach((i) => {
      sidebarOptions.push({ id: `interview:${i.id}`, title: i.title, type: "interview", typeLabel: CONTENT_TYPE_LABELS.interview, createdAtMs: toMs(i.createdAt), publishedAtMs: toMs(i.publishedAt) });
    });
  interviews
    .filter((i) => !i.isHotContent && !i.isNotebookContent)
    .forEach((i) => {
      interviewOptions.push({ id: i.id, title: i.title, createdAtMs: toMs(i.createdAt), publishedAtMs: toMs(i.publishedAt) });
    });

  heroOptions.sort((a, b) => a.typeLabel.localeCompare(b.typeLabel, "ru-RU") || a.title.localeCompare(b.title, "ru-RU"));
  sidebarOptions.sort((a, b) => a.typeLabel.localeCompare(b.typeLabel, "ru-RU") || a.title.localeCompare(b.title, "ru-RU"));
} catch (error) {
  loadError = error instanceof Error ? error.message : "Не удалось загрузить данные.";
}

const initialHero = (() => {
  if (!placements.hero) return { mode: "empty" as const, key: "" };
  return { mode: "manual" as const, key: `${placements.hero.type}:${placements.hero.id}` };
})();

const initialTwoImageArticle = (() => {
  if (!placements.twoImageArticle) return { mode: "empty" as const, key: "" };
  return { mode: "manual" as const, key: `${placements.twoImageArticle.type}:${placements.twoImageArticle.id}` };
})();

const initialInterviewFeature = (() => {
  if (!placements.interviewFeature) return { mode: "empty" as const, id: "" };
  if (placements.interviewFeature.mode === "auto-latest") return { mode: "auto-latest" as const, id: "" };
  return { mode: "manual" as const, id: placements.interviewFeature.id };
})();

const initialPhotoOfTheDay = (() => {
  if (!placements.photoOfTheDayFeature) return { mode: "empty" as const, id: "" };
  if (placements.photoOfTheDayFeature.mode === "manual") {
    return { mode: "manual" as const, id: placements.photoOfTheDayFeature.id };
  }
  return { mode: "auto-latest" as const, id: "" };
})();

const initialSecondaryStoriesMode = (() => {
  if (!placements.secondaryStories) return "empty" as const;
  return placements.secondaryStories.mode as "auto-latest";
})();

const initialSecondaryStoriesLimit =
  placements.secondaryStories?.mode === "auto-latest"
    ? placements.secondaryStories.limit
    : 2;

const initialSidebarMode = (() => {
  if (!placements.sidebarRail) return "empty" as const;
  return placements.sidebarRail.mode;
})();

const initialSidebarLimit =
  placements.sidebarRail?.mode === "auto-hot" ? placements.sidebarRail.limit : 4;

const availableSidebarKeys = new Set(sidebarOptions.map((item) => item.id));
const initialSidebarKeys =
  placements.sidebarRail?.mode === "manual"
    ? placements.sidebarRail.items
        .map((item) => `${item.type}:${item.id}`)
        .filter((key) => availableSidebarKeys.has(key))
    : [];
---

<DashboardLayout title="Редактор «Париж»" active="paris-editor">
  <section
    class="grid gap-6"
    x-data={`$lazy('parisEditor', ${JSON.stringify({
      heroOptions,
      initialHero,
      initialTwoImageArticle,
      interviewOptions,
      initialInterviewFeature,
      initialSecondaryStoriesMode,
      initialSecondaryStoriesLimit,
      photoOfTheDayOptions,
      initialPhotoOfTheDay,
      initialSidebarMode,
      initialSidebarLimit,
      sidebarOptions,
      initialSidebarKeys,
    })})`}
  >
    <div class="bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex flex-col gap-2">
        <h2 class="text-xl font-semibold">Редактор страницы «Париж»</h2>
        <p class="text-sm text-base-content/70">Управление editorial slots на странице /paris.</p>
      </div>
      <div class="mt-4 text-sm">
        <span class="font-semibold">Последнее изменение:</span>
        <span class="ml-2">{formatUpdatedAt(placements.updatedAt)}</span>
      </div>
      {loadError && <p class="mt-4 text-sm text-error">{loadError}</p>}
    </div>

    <div class="bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Hero Controls</h3>
        <p class="text-sm text-base-content/70">Главный материал в верхней части страницы /paris.</p>
      </div>

      <div class="mt-5 grid gap-5">
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-hero-mode" value="empty" x-model="heroMode" />
            <span class="text-sm">Empty</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-hero-mode" value="manual" x-model="heroMode" />
            <span class="text-sm">Manual</span>
          </label>
        </div>

        <div x-show="heroMode === 'manual'" class="grid gap-2 max-w-xl">
          <label for="paris-hero-select" class="text-sm font-medium">Выбери материал</label>
          <CustomSelect
            id="paris-hero-select"
            model="selectedHeroKey"
            itemsExpr={JSON.stringify(heroOptions)}
            placeholder="— выбери материал —"
          />
        </div>

        <p x-show="heroError" class="text-sm text-error" x-text="heroError"></p>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="px-4 py-2 rounded-lg border text-sm transition cursor-pointer bg-primary text-primary-content border-primary disabled:opacity-50 disabled:cursor-not-allowed"
            @click="saveHero()"
            :disabled="heroSaving"
          >
            Сохранить hero
          </button>
          <span x-show="heroSaving" class="text-sm text-base-content/70">Сохраняем...</span>
        </div>
      </div>
    </div>

    <div class="bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Two-Image Article Controls</h3>
        <p class="text-sm text-base-content/70">Блок-статья с двумя изображениями на странице /paris.</p>
      </div>

      <div class="mt-5 grid gap-5">
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-two-image-mode" value="empty" x-model="twoImageArticleMode" />
            <span class="text-sm">Empty</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-two-image-mode" value="manual" x-model="twoImageArticleMode" />
            <span class="text-sm">Manual</span>
          </label>
        </div>

        <div x-show="twoImageArticleMode === 'manual'" class="grid gap-2 max-w-xl">
          <label for="paris-two-image-select" class="text-sm font-medium">Выбери материал</label>
          <CustomSelect
            id="paris-two-image-select"
            model="selectedTwoImageArticleKey"
            itemsExpr={JSON.stringify(heroOptions)}
            placeholder="— выбери материал —"
          />
        </div>

        <p x-show="twoImageArticleError" class="text-sm text-error" x-text="twoImageArticleError"></p>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="px-4 py-2 rounded-lg border text-sm transition cursor-pointer bg-primary text-primary-content border-primary disabled:opacity-50 disabled:cursor-not-allowed"
            @click="saveTwoImageArticle()"
            :disabled="twoImageArticleSaving"
          >
            Сохранить two-image article
          </button>
          <span x-show="twoImageArticleSaving" class="text-sm text-base-content/70">Сохраняем...</span>
        </div>
      </div>
    </div>

    <div class="bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Interview Controls</h3>
        <p class="text-sm text-base-content/70">Блок интервью на странице /paris.</p>
      </div>

      <div class="mt-5 grid gap-5">
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-interview-mode" value="empty" x-model="interviewFeatureMode" />
            <span class="text-sm">Empty</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-interview-mode" value="auto-latest" x-model="interviewFeatureMode" />
            <span class="text-sm">Auto latest</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-interview-mode" value="manual" x-model="interviewFeatureMode" />
            <span class="text-sm">Manual</span>
          </label>
        </div>

        <div x-show="interviewFeatureMode === 'manual'" class="grid gap-2 max-w-sm">
          <label for="paris-interview-select" class="text-sm font-medium">Выбери интервью</label>
          <CustomSelect
            id="paris-interview-select"
            model="selectedInterviewFeatureId"
            itemsExpr={JSON.stringify(interviewOptions)}
            placeholder="— выбери интервью —"
          />
        </div>

        <p x-show="interviewFeatureError" class="text-sm text-error" x-text="interviewFeatureError"></p>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="px-4 py-2 rounded-lg border text-sm transition cursor-pointer bg-primary text-primary-content border-primary disabled:opacity-50 disabled:cursor-not-allowed"
            @click="saveInterviewFeature()"
            :disabled="interviewFeatureSaving"
          >
            Сохранить interview
          </button>
          <span x-show="interviewFeatureSaving" class="text-sm text-base-content/70">Сохраняем...</span>
        </div>
      </div>
    </div>

    <div class="bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Secondary Stories Controls</h3>
        <p class="text-sm text-base-content/70">Две маленькие карточки на странице /paris.</p>
      </div>

      <div class="mt-5 grid gap-5">
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-secondary-mode" value="empty" x-model="secondaryStoriesMode" />
            <span class="text-sm">Empty</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-secondary-mode" value="auto-latest" x-model="secondaryStoriesMode" />
            <span class="text-sm">Auto latest</span>
          </label>
        </div>

        <div x-show="secondaryStoriesMode === 'auto-latest'" class="grid gap-2 max-w-xs">
          <label for="paris-secondary-limit" class="text-sm font-medium">Количество карточек</label>
          <select
            id="paris-secondary-limit"
            x-model="secondaryStoriesLimit"
            class="w-full rounded-lg border border-base-300 bg-base-100 px-3 py-2.5 text-sm text-base-content focus:outline-none focus:border-neutral-400 focus:ring-1 focus:ring-neutral-400/50 cursor-pointer"
          >
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
          </select>
        </div>

        <p x-show="secondaryStoriesError" class="text-sm text-error" x-text="secondaryStoriesError"></p>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="px-4 py-2 rounded-lg border text-sm transition cursor-pointer bg-primary text-primary-content border-primary disabled:opacity-50 disabled:cursor-not-allowed"
            @click="saveSecondaryStories()"
            :disabled="secondaryStoriesSaving"
          >
            Сохранить secondary stories
          </button>
          <span x-show="secondaryStoriesSaving" class="text-sm text-base-content/70">Сохраняем...</span>
        </div>
      </div>
    </div>

    <div class="bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Photo of the Day Controls</h3>
        <p class="text-sm text-base-content/70">Блок «Фото дня» на странице /paris.</p>
      </div>

      <div class="mt-5 grid gap-5">
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-photo-of-the-day-mode" value="empty" x-model="photoOfTheDayMode" />
            <span class="text-sm">Empty</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-photo-of-the-day-mode" value="auto-latest" x-model="photoOfTheDayMode" />
            <span class="text-sm">Auto latest</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-photo-of-the-day-mode" value="manual" x-model="photoOfTheDayMode" />
            <span class="text-sm">Manual</span>
          </label>
        </div>

        <div x-show="photoOfTheDayMode === 'manual'" class="grid gap-2 max-w-sm">
          <label for="paris-photo-of-the-day-select" class="text-sm font-medium">Выбери фото</label>
          <CustomSelect
            id="paris-photo-of-the-day-select"
            model="selectedPhotoOfTheDayId"
            itemsExpr={JSON.stringify(photoOfTheDayOptions)}
            placeholder="— выбери фото —"
          />
        </div>

        <p x-show="photoOfTheDayError" class="text-sm text-error" x-text="photoOfTheDayError"></p>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="px-4 py-2 rounded-lg border text-sm transition cursor-pointer bg-primary text-primary-content border-primary disabled:opacity-50 disabled:cursor-not-allowed"
            @click="savePhotoOfTheDay()"
            :disabled="photoOfTheDaySaving"
          >
            Сохранить photo of the day
          </button>
          <span x-show="photoOfTheDaySaving" class="text-sm text-base-content/70">Сохраняем...</span>
        </div>
      </div>
    </div>

    <div class="bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Sidebar Rail Controls</h3>
        <p class="text-sm text-base-content/70">Блок «Записная книжка» в правой колонке /paris.</p>
      </div>

      <div class="mt-5 grid gap-5">
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-sidebar-mode" value="empty" x-model="sidebarMode" />
            <span class="text-sm">Empty</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-sidebar-mode" value="auto-hot" x-model="sidebarMode" />
            <span class="text-sm">Auto notebook</span>
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
            <input type="radio" name="paris-sidebar-mode" value="manual" x-model="sidebarMode" />
            <span class="text-sm">Manual</span>
          </label>
        </div>

        <div x-show="sidebarMode === 'auto-hot'" class="grid gap-2 max-w-xs">
          <label for="paris-sidebar-limit" class="text-sm font-medium">Количество материалов</label>
          <select
            id="paris-sidebar-limit"
            x-model="sidebarLimit"
            class="w-full rounded-lg border border-base-300 bg-base-100 px-3 py-2.5 text-sm text-base-content focus:outline-none focus:border-neutral-400 focus:ring-1 focus:ring-neutral-400/50 cursor-pointer"
          >
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
          </select>
        </div>

        <div x-show="sidebarMode === 'manual'" class="grid gap-3">
          <p class="text-sm font-medium">
            Выбери материалы с флагом «Записная книжка». Порядок выбора сохранится в rail.
          </p>
          {
            sidebarOptions.length > 0 ? (
              <div class="grid gap-2 max-h-80 overflow-y-auto pr-1">
                {sidebarOptions.map((item) => (
                  <label class="flex items-start gap-3 rounded-lg border border-base-300 p-3 cursor-pointer">
                    <input
                      type="checkbox"
                      :checked={`isManualSidebarSelected(${JSON.stringify(item.id)})`}
                      @change={`toggleSidebarItem(${JSON.stringify(item.id)})`}
                    />
                    <span class="flex flex-col gap-1 text-sm leading-6">
                      <span class="font-medium">{item.title}</span>
                      <span class="text-xs uppercase tracking-[0.22em] text-base-content/55">
                        {item.typeLabel}
                      </span>
                    </span>
                  </label>
                ))}
              </div>
            ) : (
              <p class="text-sm text-base-content/60">
                Нет материалов с флагом «Записная книжка».
              </p>
            )
          }
        </div>

        <p x-show="sidebarError" class="text-sm text-error" x-text="sidebarError"></p>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="px-4 py-2 rounded-lg border text-sm transition cursor-pointer bg-primary text-primary-content border-primary disabled:opacity-50 disabled:cursor-not-allowed"
            @click="saveSidebarRail()"
            :disabled="sidebarSaving"
          >
            Сохранить sidebar rail
          </button>
          <span x-show="sidebarSaving" class="text-sm text-base-content/70">Сохраняем...</span>
        </div>
      </div>
    </div>
  </section>
</DashboardLayout>
