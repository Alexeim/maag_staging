---
// Test page to test stuff, only for admins

// Layout
import Layout from "@/Layouts/Layout.astro";

import { ShieldAlert } from "@lucide/astro";
// Import stuff to test
import FirstPersonCard from "@/components/common/FirstPersonCard.astro";
import OpinionCard from "@/components/common/OpinionCard.astro";
---

<Layout>
  <div class="bg-amber-500 w-full flex flex-row items-center justify-center p-2">
    <ShieldAlert />
    <h1 class="font-bold px-2">Testing Page (admins only)</h1>
    <ShieldAlert />
  </div>
  <div class="min-h-screen flex items-center justify-center">
    <div class="w-[320px]">
      <OpinionCard
        category="мнение"
        authorName="Роман Должанский"
        title={
          "о том, как он попал в DAU Ильи Хржановского и сыграл самого себя."
        }
        imageUrl={
          "https://images.pexels.com/photos/30530414/pexels-photo-30530414.jpeg"
        }
        href={"/"}
      />
    </div>
  </div>
</Layout>
