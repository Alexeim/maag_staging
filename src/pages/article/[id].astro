---
import type { ComponentProps } from "astro/types";
import Layout from "../../Layouts/Layout.astro";
import ArticleHero from "../../components/article/ArticleHero.astro";
import ArticleBody from "../../components/article/ArticleBody.astro";
import RelatedMaterialsMarquee from "@/components/article/RelatedMaterialsMarquee.astro";
import picture1 from "@/assets/images/culture.jpg";
import {
  getPrimaryBadgeHref,
  getPrimaryBadgeLabel,
  getTagLabel,
} from "@/lib/utils/contentBadge";
import {
  ApiError,
  articlesApi,
  publicRelatedApi,
  type ArticleResponse,
  type PublicRelatedCard,
} from "@/lib/api/api";
import { canPreviewUnpublished } from "@/lib/utils/preview";
import DraftPreviewBanner from "@/components/common/DraftPreviewBanner.astro";
import {
  normalizeTags,
  type LinkedContentLookup,
  toDate,
} from "@/lib/utils/contentCollectionMarquee";

type ArticleBodyProps = ComponentProps<typeof ArticleBody>;

const { id } = Astro.params;
if (!id) return Astro.redirect("/404");

// Paris/Culture site-section labels, used for the bookmark section indicator
// below — unrelated to the material's tag badge.
const CATEGORY_LABELS: Record<string, string> = {
  culture: "Культура",
  paris: "Париж",
  hotContent: "Самое Читаемое",
};

let articleData: ArticleResponse | null = null;
let collectionContentItems: PublicRelatedCard[] = [];
let relatedContentItems: PublicRelatedCard[] = [];
let sameCategoryItems: PublicRelatedCard[] = [];
let linkedContentLookup: LinkedContentLookup = {};
let error: string | null = null;

try {
  articleData = await articlesApi.getById(id);
} catch (e) {
  Astro.response.status = e instanceof ApiError && e.status === 404 ? 404 : 503;
  console.error(e);
  if (e instanceof ApiError) {
    error =
      e.status === 404
        ? "Article not found."
        : `Error fetching article: ${e.message}`;
  } else {
    error = `Error fetching article: ${e instanceof Error ? e.message : String(e)}`;
  }
}

// Admins may preview an unpublished article on its real page; everyone else
// gets the usual "not found".
const isDraftPreview =
  !error && Boolean(articleData) && articleData?.published !== true &&
  canPreviewUnpublished(Astro.locals);

if (!error && articleData?.published !== true && !isDraftPreview) {
  Astro.response.status = 404;
  error = "Article not found.";
  articleData = null;
}

// Redirect tips articles to their dedicated page
if (articleData?.articleType === 'tips') {
  return Astro.redirect(`/tips/${id}`);
}

// Normalize data for the template
const rawCategory = articleData?.category ?? null;

const displayArticle = {
  title: articleData?.title || 'Article',
  lead: articleData?.lead || '',
  leadHtml: articleData?.leadHtml || '',
  category: getPrimaryBadgeLabel({ contentType: "article", tags: articleData?.tags }),
  categoryHref: getPrimaryBadgeHref({ contentType: "article", tags: articleData?.tags }),
  authorName: articleData?.author ? `${articleData.author.firstName} ${articleData.author.lastName}` : 'Author',
  authorAvatar: articleData?.author?.avatar,
  authorId: articleData?.author ? articleData?.authorId : undefined,
  imageUrl: articleData?.imageUrl, // For dynamic articles
  imageCaption: articleData?.imageCaption || '', // <-- Get the caption
  imageAlt: articleData?.title || 'Article image',
  // Stored blocks are unvalidated JSON; ArticleBody renders them by `type`.
  contentBlocks: (articleData?.content || []) as ArticleBodyProps["contentBlocks"],
};

const bookmarkCategory =
  rawCategory === "culture" || rawCategory === "paris"
    ? CATEGORY_LABELS[rawCategory]
    : "";
const firstBookmarkTag = normalizeTags(articleData?.tags)[0] ?? "";
const bookmarkTag = firstBookmarkTag ? getTagLabel(firstBookmarkTag) : "";

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = new URL(`/article/${id}`, siteOrigin).toString();
const organizationId = new URL("/#organization", siteOrigin).toString();
const toAbsoluteUrl = (value?: string) =>
  value ? new URL(value, siteOrigin).toString() : undefined;
const toIsoDate = (value: unknown) => toDate(value)?.toISOString();
const articleAuthor = articleData?.author
  ? {
      "@type": "Person",
      name: displayArticle.authorName,
    }
  : {
      "@id": organizationId,
    };
const articleStructuredData = articleData
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: displayArticle.title,
      description: displayArticle.lead,
      image: displayArticle.imageUrl
        ? [toAbsoluteUrl(displayArticle.imageUrl)]
        : undefined,
      datePublished: toIsoDate(articleData.publishedAt),
      dateModified: toIsoDate(articleData.updatedAt ?? articleData.publishedAt),
      author: articleAuthor,
      publisher: {
        "@id": organizationId,
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalUrl,
      },
      inLanguage: "ru",
    }
  : [];

if (!error && articleData) {
  try {
    // The server picks the cards (published only, card fields only) — see
    // server/src/controllers/publicRelatedController.ts.
    const cards = await publicRelatedApi.get("article", id);
    collectionContentItems = cards.collection;
    relatedContentItems = cards.related;
    sameCategoryItems = cards.autofill;
    linkedContentLookup = cards.linked;
  } catch (relatedError) {
    console.error("Failed to fetch collection content for article page:", relatedError);
  }
}

const isAKid = displayArticle.authorName === "Саша Макарова";
---

<Layout
  navbarVariant="default"
  includePreFooterCTA={false}
  title={`${displayArticle.title} - Maag`}
  description={displayArticle.lead}
  image={displayArticle.imageUrl}
  canonicalPath={`/article/${id}`}
  type="article"
  structuredData={articleStructuredData}
  useClientRouter={true}
>
  {isDraftPreview && (
    <DraftPreviewBanner editHref={`/dashboard/article/${id}/edit`} />
  )}
  <main class="bg-base-200 min-h-screen">
    <div class="max-w-[1512px] mx-auto">
      {error && <div class="text-red-500 text-center pt-40">{error}</div>}
      {!error && articleData && (
        <>
          <ArticleHero
            category={displayArticle.category}
            categoryHref={displayArticle.categoryHref}
            title={displayArticle.title}
            lead={displayArticle.lead}
            leadHtml={displayArticle.leadHtml}
            authorName={displayArticle.authorName}
            authorAvatar={displayArticle.authorAvatar}
            authorId={displayArticle.authorId}
            isKid={isAKid}
            createdAt={articleData.publishedAt}
            imageUrl={displayArticle.imageUrl}
            imageAlt={displayArticle.imageAlt}
            imageCaption={displayArticle.imageCaption}
            transitionName={`main-article-image-${id}`}
            heroOrientation={articleData?.heroOrientation ?? "image-right"}
            actions={{
              contentType: "article",
              contentId: id,
              href: `/article/${id}`,
              category: bookmarkCategory,
              tag: bookmarkTag,
            }}
          />

          <!-- Article Content -->
          <div class="w-full px-4 lg:px-14 pt-10 pb-[100px] lg:pt-16">
            <ArticleBody
              contentBlocks={displayArticle.contentBlocks}
              linkedContentLookup={linkedContentLookup}
            />

            <RelatedMaterialsMarquee
              collectionItems={collectionContentItems}
              relatedItems={relatedContentItems}
              categoryItems={sameCategoryItems}
              fallbackImageSrc={picture1.src}
            />
          </div>
        </>
      )}
    </div>
  </main>
</Layout>
