---
import Layout from "../../Layouts/Layout.astro";
import {
  ApiError,
  interviewsApi,
  publicRelatedApi,
  type PublicRelatedCard,
} from "../../lib/api/api";
import { canPreviewUnpublished } from "@/lib/utils/preview";
import DraftPreviewBanner from "@/components/common/DraftPreviewBanner.astro";
import type { ComponentProps } from "astro/types";
import RegisteredArticleBody from "../../components/article/RegisteredArticleBody.astro";
import RelatedMaterialsMarquee from "@/components/article/RelatedMaterialsMarquee.astro";
import InterviewHero from "@/components/interview/InterviewHero.astro";
import { getKnownTagLabel } from "@/content/tags/tags";
import picture1 from "@/assets/images/culture.jpg";
import {
  normalizeTags,
  type LinkedContentLookup,
} from "@/lib/utils/contentCollectionMarquee";
import { buildArticleStructuredData } from "@/lib/seo/structuredData";

type ArticleBodyProps = ComponentProps<typeof RegisteredArticleBody>;

const { id } = Astro.params;

if (!id) return Astro.rewrite("/404");

// A missing interview answers 404 at its own URL instead of redirecting to
// /404 (Search Console: "Page with redirect"). Any other API failure is a real
// server error and is no longer disguised as "not found".
let interview: Awaited<ReturnType<typeof interviewsApi.getById>>;
try {
  interview = await interviewsApi.getById(id);
} catch (error) {
  if (error instanceof ApiError && error.status === 404) {
    return Astro.rewrite("/404");
  }
  throw error;
}

if (!interview) {
  return Astro.rewrite("/404");
}

// Admins may preview an unpublished interview on its real page; everyone else
// gets the 404 page.
const isDraftPreview =
  interview.published !== true && canPreviewUnpublished(Astro.locals);

if (interview.published !== true && !isDraftPreview) {
  return Astro.rewrite("/404");
}

console.log("here --------------------->>>>>>>>>", Object.keys(interview));

const {
  title,
  author,
  authorId,
  interviewee,
  mainQuote,
  content,
  imageUrl,
  imageCaption,
  lead,
  leadHtml,
} = interview;
const authorName = author ? `${author.firstName} ${author.lastName}` : "MAAG";
const resolvedAuthorId = author ? authorId : undefined;
const firstBookmarkTag = normalizeTags(interview.tags)[0] ?? "";
const bookmarkTag = firstBookmarkTag ? getKnownTagLabel(firstBookmarkTag) : "";
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const articleStructuredData = buildArticleStructuredData({
  siteOrigin,
  path: `/interviews/${id}`,
  headline: title,
  description: lead,
  image: imageUrl,
  datePublished: interview.publishedAt,
  dateModified: interview.updatedAt ?? interview.publishedAt,
  authorName: author ? authorName : undefined,
});

let collectionContentItems: PublicRelatedCard[] = [];
let relatedContentItems: PublicRelatedCard[] = [];
let recentInterviewItems: PublicRelatedCard[] = [];
let linkedContentLookup: LinkedContentLookup = {};

try {
  // The server picks the cards (published only, card fields only) — see
  // server/src/controllers/publicRelatedController.ts.
  const cards = await publicRelatedApi.get("interview", id!);
  collectionContentItems = cards.collection;
  relatedContentItems = cards.related;
  recentInterviewItems = cards.autofill;
  linkedContentLookup = cards.linked;
} catch (e) {
  console.error("Failed to fetch collection content for interview page:", e);
}
---

<Layout
  navbarVariant="default"
  title={`${title} - Maag`}
  description={lead}
  image={imageUrl}
  canonicalPath={`/interviews/${id}`}
  type="article"
  structuredData={articleStructuredData}
  useClientRouter={true}
>
  {isDraftPreview && (
    <DraftPreviewBanner editHref={`/dashboard/interview/${id}/edit`} />
  )}
  <main class="bg-base-200 min-h-screen">
    <div class="max-w-[1512px] mx-auto">
      <InterviewHero
        category="Интервью"
        categoryHref="/interviews"
        title={title}
        lead={lead}
        leadHtml={leadHtml}
        authorName={authorName}
        authorAvatar={author?.avatar}
        authorId={resolvedAuthorId}
        interviewee={interviewee}
        mainQuote={mainQuote || ""}
        createdAt={interview.publishedAt}
        imageUrl={imageUrl}
        imageAlt={imageCaption || title}
        imageCaption={imageCaption}
        transitionName={`main-article-image-${id}`}
        heroOrientation={interview?.heroOrientation ?? "image-left"}
        actions={{
          contentType: "interview",
          contentId: id!,
          href: `/interviews/${id}`,
          tag: bookmarkTag,
        }}
      />

      <div class="px-4 pb-[100px] pt-10 sm:px-6 lg:px-14 lg:pt-16">
        <RegisteredArticleBody
          paid={interview.paid}
          contentBlocks={
            // Stored blocks are unvalidated JSON; ArticleBody renders them by `type`.
            (Array.isArray(content) ? content : []) as ArticleBodyProps["contentBlocks"]
          }
          linkedContentLookup={linkedContentLookup}
        />
        <RelatedMaterialsMarquee
          collectionItems={collectionContentItems}
          relatedItems={relatedContentItems}
          categoryItems={recentInterviewItems}
          fallbackImageSrc={picture1.src}
        />
      </div>
    </div>
  </main>
</Layout>
