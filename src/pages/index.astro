---
import Layout from "../Layouts/Layout.astro";
import { getSectionMeta } from "@/lib/i18n/pageMeta";
import Hero from "../components/HomePage/Hero.astro";
import MainLandingBlock from "../components/common/MainLandingBlock.astro";
import LandingBody from "../components/common/LandingBody.astro";
import { publicLandingApi } from "@/lib/api/api";

import { getRequestLocale } from "@/lib/i18n/request";

const locale = getRequestLocale(Astro);

const EMPTY_PUBLIC_LANDING = {
  mainBlock: {
    mainArticle: null,
    newsArticles: [],
    landingEvent: null,
  },
  body: {
    cultureHero: null,
    cultureCardItems: [],
    parisHero: null,
    parisCardItems: [],
    maagChoiceItems: [],
    latestInterview: null,
    carouselItems: [],
    leSaviezVousArticle: null,
    photoOfTheDay: null,
  },
};

const publicLanding = await publicLandingApi.get({
    locale,
    sessionCookie: Astro.cookies.get("__session")?.value,
  }).catch((error) => {
  console.error("Failed to load public landing data:", error);
  return EMPTY_PUBLIC_LANDING;
});
---

<Layout
  navbarVariant="default"
  {...getSectionMeta("home", Astro.originPathname)}
  useClientRouter={true}
>
  <main>
    <Hero />
    <MainLandingBlock data={publicLanding.mainBlock} />
    <LandingBody data={publicLanding.body} />
  </main>
</Layout>
